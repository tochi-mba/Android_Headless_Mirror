# Android Headless Mirror: only generated and per-machine files are ignored.

# Downloaded tools (scrcpy/adb) and the built app (tools/rex). Binaries are never committed.
tools/

# Per-machine runtime state: phone serials, lock-screen answers, window placement, logs, captures.
state.json
logs/
captures/
*.log
config.json.rex-backup
config.json.tmp
state.json.tmp

# Build output
bin/
obj/
artifacts/
dist/
TestResults/
*.trx

# Node / Playwright (Pages tests)
node_modules/
playwright-report/
test-results/

# Editors and OS
.vs/
.idea/
*.user
*.suo
.DS_Store
Thumbs.db
