    "NavigatorWidth": 150,
    "NavigatorPicture": true,
    "NavigatorOpacity": 0.92,
    "NavigatorFrameRate": 30,
    "NavigatorAlways": false
  },
  "Copies": {
    "Most": 3,
    "Gap": 12,
    "MaxSize": 0,
    "Remember": true
  },
  "Ambient": {
    "Enabled": true,
    "Opacity": 0.42,
    "Blur": 24,
    "Placement": "around",
    "Scaling": "cover",
    "Size": 1,
