{
  "Version": 2,
  "Mirror": {
    "MaxSize": 1920,
    "MaxFps": 60,
    "VideoBitRate": "12M",
    "VideoCodec": "h264",
    "Audio": true,
    "AudioCodec": "opus",
    "AudioBufferMs": 50,
    "AudioDup": false,
    "RecordOnStart": false,
    "RecordDirectory": "captures/recordings",
    "ExtraArgs": ""
  },
  "Session": {
    "TurnScreenOff": true,
    "StayAwake": true,
    "KeepActive": true,
    "WakeBeforeMirror": true,
    "DismissKeyguard": true,
    "PowerOffOnClose": false,
    "RestartOnUnexpectedExit": true,
    "PreferUsb": true,
    "PreferredSerial": "",
    "PollSeconds": 1,
    "RetrySeconds": 4
  },
  "Wireless": {
    "Enabled": false,
    "Port": 5555,
    "EnableTcpipWhenUsbAvailable": false,
    "ManualHosts": []
  },
  "Touchpad": {
    "Enabled": true,
    "TwoFingerToAndroid": true,
    "Sensitivity": 1
  },
  "Zoom": {
    "Enabled": true,
    "WheelZoom": true,
    "PinchZoom": true,
    "MaxZoom": 4,
    "WheelStep": 0.1,
    "ShowNavigator": true
  },
  "PatternGuide": {
    "Enabled": true,
    "AskPerDevice": true,
    "AutoShowOnKeyguard": true,
    "AutoDiscoverGeometry": true,
    "CalibrationEnabled": true,
    "ShowCursorTrail": true,
    "Opacity": 0.9
  },
  "App": {
    "RunInBackground": true,
    "OpenOnConnect": true,
    "ConfirmSensitiveWrites": true,
    "ScreenshotDirectory": "captures/screenshots",
    "AmbientBackground": true,
    "AmbientBlur": 24,
    "AmbientDim": 0.58,
    "PreviewIntervalSeconds": 2,
    "HudHideSeconds": 3
  },
  "Logging": {
    "Enabled": true,
    "MaxBytes": 2097152,
    "KeepFiles": 5
  }
}
