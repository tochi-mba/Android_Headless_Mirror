{
  "Version": 2,
  "Mirror": {
    "MaxSize": 1920,
    "MaxFps": 60,
    "VideoBitRate": "12M",
    "VideoCodec": "h264",
    "Audio": true,
    "AudioCodec": "opus",
    "AudioBufferMs": 50,
    "AudioDup": false,
    "RecordOnStart": false,
    "RecordDirectory": "captures/recordings",
    "ExtraArgs": ""
  },
  "Session": {
    "TurnScreenOff": true,
    "StayAwake": true,
    "KeepActive": true,
    "WakeBeforeMirror": true,
    "DismissKeyguard": true,
    "PowerOffOnClose": false,
    "RestartOnUnexpectedExit": true,
    "PreferUsb": true,
    "PreferredSerial": "",
    "PollSeconds": 1,
    "RetrySeconds": 4
  },
  "Wireless": {
    "Enabled": false,
    "Port": 5555,
    "EnableTcpipWhenUsbAvailable": false,
    "ManualHosts": []
  },
  "Touchpad": {
    "Enabled": true,
    "TwoFingerToAndroid": true,
    "Sensitivity": 1
  },
  "Zoom": {
    "Enabled": true,
    "WheelZoom": true,
    "PinchZoom": true,
    "MaxZoom": 4,
    "WheelStep": 0.1,
    "ShowNavigator": true,
    "NavigatorCorner": "bottom-right",
    "NavigatorWidth": 150
  },
  "Ambient": {
    "Enabled": true,
    "Opacity": 0.42,
    "Blur": 24,
    "Placement": "around",
    "Scaling": "cover",
    "Size": 1,
    "OffsetX": 0,
    "OffsetY": 0,
    "FlipHorizontal": false,
    "EdgeFade": 0,
    "TintStrength": 0,
    "TintHue": 75,
    "FrameRate": 15
  },
  "Hud": {
    "Enabled": true,
    "Position": "top",
    "X": null,
    "Y": null,
    "Buttons": [
      "back",
      "home",
      "recents",
      "rotation-portrait",
      "rotation-landscape",
      "rotation-auto",
      "zoom-reset",
      "screenshot",
      "fullscreen"
    ],
    "HideSeconds": 3,
    "Scale": 1,
    "Opacity": 1,
    "ShowMessages": true
  },
  "PatternGuide": {
    "Enabled": true,
    "AskPerDevice": true,
    "AutoShowOnKeyguard": true,
    "AutoDiscoverGeometry": true,
    "CalibrationEnabled": true,
    "ShowCursorTrail": true,
    "Opacity": 0.9
  },
  "App": {
    "RunInBackground": true,
    "OpenOnConnect": true,
    "ConfirmSensitiveWrites": true,
    "ScreenshotDirectory": "captures/screenshots"
  },
  "Logging": {
    "Enabled": true,
    "MaxBytes": 2097152,
    "KeepFiles": 5
  }
}
