{
  "Version": 2,
  "Mirror": {
    "MaxSize": 1920,
    "MaxFps": 60,
    "VideoBitRate": "12M",
    "VideoCodec": "h264",
    "Audio": true,
    "AudioCodec": "opus",
    "AudioBufferMs": 50,
    "AudioDup": false,
    "AudioSource": "auto",
    "AudioBitRate": "128K",
    "VideoBufferMs": 0,
    "DownsizeOnError": true,
    "RenderDriver": "",
    "RecordFormat": "mp4",
    "RecordOnStart": false,
    "RecordDirectory": "captures/recordings",
    "ExtraArgs": "",
    "CompatibilityKeyboard": false
  },
  "Session": {
    "TurnScreenOff": true,
    "StayAwake": true,
    "KeepActive": true,
    "WakeBeforeMirror": true,
    "DismissKeyguard": true,
    "PowerOffOnClose": false,
    "RestartOnUnexpectedExit": true,
    "ScreenOffTimeoutSeconds": 0,
    "KeepPcAwake": false,
    "StartApp": "",
    "PreferUsb": true,
    "PreferredSerial": "",
