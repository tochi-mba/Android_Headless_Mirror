<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:views="clr-namespace:Rex.Mirror.Views">

  <!-- REX palette -->
  <Color x:Key="InkColor">#080A09</Color>
  <Color x:Key="PanelColor">#111512</Color>
  <Color x:Key="RaisedColor">#181E19</Color>
  <Color x:Key="LineColor">#29302A</Color>
  <Color x:Key="TextColor">#F2F5EE</Color>
  <Color x:Key="MutedColor">#858D83</Color>
  <Color x:Key="SignalColor">#D7FF3F</Color>
  <Color x:Key="LiveColor">#FF774D</Color>

  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="Panel" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="Raised" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="Line" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="Signal" Color="{StaticResource SignalColor}" />
  <SolidColorBrush x:Key="SignalWash" Color="#1AD7FF3F" />
  <SolidColorBrush x:Key="Live" Color="{StaticResource LiveColor}" />
  <SolidColorBrush x:Key="LiveWash" Color="#1AFF774D" />
  <SolidColorBrush x:Key="Hover" Color="#202820" />
  <!-- Tints for the apps' letter tiles: dark enough for the text colour on top, from the same
       family as the palette. LetterTile picks one from the package, so an app keeps its tint. -->
  <SolidColorBrush x:Key="AppTile0" Color="#2A3517" />
  <SolidColorBrush x:Key="AppTile1" Color="#3A2418" />
  <SolidColorBrush x:Key="AppTile2" Color="#17302E" />
  <SolidColorBrush x:Key="AppTile3" Color="#2C2238" />
  <SolidColorBrush x:Key="AppTile4" Color="#33301A" />
  <SolidColorBrush x:Key="AppTile5" Color="#1D2A35" />
  <!-- The outline of a box you type into: 3:1 against the panel and the ink inside it, so an empty
       box still reads as a box. Line is only 1.4:1 there. -->
  <SolidColorBrush x:Key="Field" Color="#5F675E" />
  <!-- A switch's track under the pointer, a step up from Line. -->
  <SolidColorBrush x:Key="TrackHover" Color="#343C35" />

  <FontFamily x:Key="Mono">Consolas</FontFamily>

  <!-- Icons (24x24 paths) -->
  <Geometry x:Key="IconHome">M4 11 L12 4 L20 11 V20 H14 V14 H10 V20 H4 Z</Geometry>
  <Geometry x:Key="IconBack">M15 5 L8 12 L15 19</Geometry>
  <Geometry x:Key="IconRecents">M6 6 H18 V18 H6 Z</Geometry>
  <Geometry x:Key="IconPower">M12 3 V11 M6.3 6.3 A8 8 0 1 0 17.7 6.3</Geometry>
  <Geometry x:Key="IconMoon">M14 3 A9 9 0 1 0 21 13 A7 7 0 0 1 14 3 Z</Geometry>
  <Geometry x:Key="IconSun">M12 7 A5 5 0 1 0 12 17 A5 5 0 1 0 12 7 M12 2 V4 M12 20 V22 M2 12 H4 M20 12 H22 M5 5 L6.5 6.5 M17.5 17.5 L19 19 M5 19 L6.5 17.5 M17.5 6.5 L19 5</Geometry>
  <Geometry x:Key="IconVolumeDown">M4 10 H8 L13 6 V18 L8 14 H4 Z M16 10 V14</Geometry>
  <Geometry x:Key="IconVolumeUp">M4 10 H8 L13 6 V18 L8 14 H4 Z M16 9 A4 4 0 0 1 16 15 M18 6 A8 8 0 0 1 18 18</Geometry>
  <Geometry x:Key="IconMute">M4 10 H8 L13 6 V18 L8 14 H4 Z M16 9.5 L21 14.5 M21 9.5 L16 14.5</Geometry>
  <!-- The phone's sound on this PC: a speaker inside a screen, so it never looks like the phone's own volume. -->
  <Geometry x:Key="IconPcSound">M3 4 H21 V16 H3 Z M9 20 H15 M12 16 V20 M6 8.5 H8 L10.5 6.5 V13.5 L8 11.5 H6 Z M13 8.5 A2.5 2.5 0 0 1 13 11.5</Geometry>
  <Geometry x:Key="IconPcSoundUp">M3 4 H21 V16 H3 Z M9 20 H15 M12 16 V20 M6 8.5 H8 L10.5 6.5 V13.5 L8 11.5 H6 Z M13 8.5 A2.5 2.5 0 0 1 13 11.5 M15 7 A5 5 0 0 1 15 13</Geometry>
  <Geometry x:Key="IconPcSoundDown">M3 4 H21 V16 H3 Z M9 20 H15 M12 16 V20 M6 8.5 H8 L10.5 6.5 V13.5 L8 11.5 H6 Z M13 10 H17</Geometry>
  <Geometry x:Key="IconPcMute">M3 4 H21 V16 H3 Z M9 20 H15 M12 16 V20 M6 8.5 H8 L10.5 6.5 V13.5 L8 11.5 H6 Z M13 8 L17 12 M17 8 L13 12</Geometry>
  <Geometry x:Key="IconPcSoundOff">M3 4 H21 V16 H3 Z M9 20 H15 M12 16 V20 M6 8.5 H8 L10.5 6.5 V13.5 L8 11.5 H6 Z M4 15 L20 5</Geometry>
  <Geometry x:Key="IconRotate">M20 12 A8 8 0 1 1 16 5.1 M16 2 V6 H12</Geometry>
  <Geometry x:Key="IconRotateLeft">M4 12 A8 8 0 1 0 8 5.1 M8 2 V6 H12</Geometry>
  <!-- The phone itself turning, rather than the picture of it on this PC. -->
  <Geometry x:Key="IconRotatePhone">M7 8 H15 A1.5 1.5 0 0 1 16.5 9.5 V20.5 A1.5 1.5 0 0 1 15 22 H7 A1.5 1.5 0 0 1 5.5 20.5 V9.5 A1.5 1.5 0 0 1 7 8 Z M12 4 A8 8 0 0 1 20 12 M17.5 10 L20 12.5 L22.5 10</Geometry>
  <Geometry x:Key="IconChevronUp">M6 15 L12 9 L18 15</Geometry>
  <!-- A layout is a language's arrangement of the keys, so a globe rather than another keyboard. -->
  <Geometry x:Key="IconKeyboardLayout">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3 12 H21 M12 3 C8.5 6.5 8.5 17.5 12 21 M12 3 C15.5 6.5 15.5 17.5 12 21</Geometry>
  <Geometry x:Key="IconCamera">M4 8 H8 L10 5 H14 L16 8 H20 V19 H4 Z M12 10 A3.5 3.5 0 1 0 12 17 A3.5 3.5 0 1 0 12 10</Geometry>
  <Geometry x:Key="IconBell">M6 17 V11 A6 6 0 0 1 18 11 V17 L20 19 H4 Z M10 21 H14</Geometry>
  <Geometry x:Key="IconSettings">M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 M12 2 V5 M12 19 V22 M2 12 H5 M19 12 H22 M4.9 4.9 L7 7 M17 17 L19.1 19.1 M4.9 19.1 L7 17 M17 7 L19.1 4.9</Geometry>
  <Geometry x:Key="IconPhone">M8 3 H16 A2 2 0 0 1 18 5 V19 A2 2 0 0 1 16 21 H8 A2 2 0 0 1 6 19 V5 A2 2 0 0 1 8 3 Z M10 18 H14</Geometry>
  <Geometry x:Key="IconSliders">M4 6 H20 M4 12 H20 M4 18 H20 M8 4 V8 M16 10 V14 M10 16 V20</Geometry>
  <!-- The phone and a wider screen beside it. -->
  <Geometry x:Key="IconSecondScreen">M3 6 H8 V18 H3 Z M11 8 H21 V16 H11 Z M14 19 H18</Geometry>
  <Geometry x:Key="IconApps">M5 5 H8 V8 H5 Z M10.5 5 H13.5 V8 H10.5 Z M16 5 H19 V8 H16 Z M5 10.5 H8 V13.5 H5 Z M10.5 10.5 H13.5 V13.5 H10.5 Z M16 10.5 H19 V13.5 H16 Z M5 16 H8 V19 H5 Z M10.5 16 H13.5 V19 H10.5 Z M16 16 H19 V19 H16 Z</Geometry>
  <Geometry x:Key="IconStar">M12 3.5 L14.6 8.9 L20.5 9.6 L16.1 13.6 L17.3 19.5 L12 16.6 L6.7 19.5 L7.9 13.6 L3.5 9.6 L9.4 8.9 Z</Geometry>
  <Geometry x:Key="IconInfo">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 10 V17 M12 7 V7.5</Geometry>
  <Geometry x:Key="IconSidebar">M4 5 H20 V19 H4 Z M15 5 V19</Geometry>
  <Geometry x:Key="IconFullscreen">M4 9 V4 H9 M15 4 H20 V9 M20 15 V20 H15 M9 20 H4 V15</Geometry>
  <Geometry x:Key="IconZoomOut">M4 12 H20</Geometry>
  <Geometry x:Key="IconZoomIn">M4 12 H20 M12 4 V20</Geometry>
  <Geometry x:Key="IconPause">M8 5 V19 M16 5 V19</Geometry>
  <Geometry x:Key="IconPlay">M7 4 L19 12 L7 20 Z</Geometry>
  <Geometry x:Key="IconRefresh">M4 12 A8 8 0 0 1 18 6.3 M20 3 V8 H15 M20 12 A8 8 0 0 1 6 17.7 M4 21 V16 H9</Geometry>
  <Geometry x:Key="IconClipboard">M9 4 H15 V7 H9 Z M7 6 H5 V21 H19 V6 H17</Geometry>
  <Geometry x:Key="IconCopy">M9 9 H19 V21 H9 Z M5 16 V3 H15 V5</Geometry>
  <Geometry x:Key="IconCut">M9.5 17 A2.5 2.5 0 1 1 4.5 17 A2.5 2.5 0 1 1 9.5 17 Z M19.5 17 A2.5 2.5 0 1 1 14.5 17 A2.5 2.5 0 1 1 19.5 17 Z M8.6 15.1 L17 3 M15.4 15.1 L7 3</Geometry>
  <!-- The clipboard with a T on it: its text typed out, key by key. -->
  <Geometry x:Key="IconTypeClipboard">M9 4 H15 V7 H9 Z M7 6 H5 V21 H19 V6 H17 M9 11 H15 M12 11 V18</Geometry>
  <Geometry x:Key="IconKeyboard">M3 7 H21 V17 H3 Z M7 11 H7.5 M11 11 H11.5 M15 11 H15.5 M8 14 H16</Geometry>
  <Geometry x:Key="IconArrowUp">M12 20 V4 M5 11 L12 4 L19 11</Geometry>
  <Geometry x:Key="IconArrowDown">M12 4 V20 M5 13 L12 20 L19 13</Geometry>
  <Geometry x:Key="IconArrowLeft">M20 12 H4 M11 5 L4 12 L11 19</Geometry>
  <Geometry x:Key="IconArrowRight">M4 12 H20 M13 5 L20 12 L13 19</Geometry>
  <Geometry x:Key="IconTap">M9 12 A3 3 0 1 1 15 12 A3 3 0 1 1 9 12 Z M5 12 A7 7 0 1 1 19 12 A7 7 0 1 1 5 12 Z</Geometry>
  <Geometry x:Key="IconHeart">M12 20 L4.5 12.5 A4.2 4.2 0 0 1 12 7 A4.2 4.2 0 0 1 19.5 12.5 Z</Geometry>

  <!-- Base text -->
  <Style TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,18,0,8" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons -->
  <Style x:Key="BaseButton" TargetType="ButtonBase">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <!-- Centred unless a control asks otherwise: the combo box stretches its own content so its
         text starts at the left and its chevron sits at the right. -->
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ButtonBase">
          <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}" />
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Hover}" />
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Line}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}" />

  <!-- Pill: a rounded button that reads as a chip. Used for the device chip in the top bar. -->
  <Style x:Key="Pill" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="{StaticResource Signal}" />
    <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="BorderBrush" Value="{StaticResource Live}" />
    <Setter Property="Foreground" Value="{StaticResource Live}" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- A full-width button that stays in while its mode is on (browse mode). The state is also
       spelled out inside it, since hovering repaints the button the same either way. -->
  <Style x:Key="WideToggle" TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,8" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource SignalWash}" />
        <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Chip: a pill that is either in or out. Used to pick from a set, never for a lone setting. -->
  <Style x:Key="Chip" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Pill" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="999" Padding="11,6" TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Pill" Property="Background" Value="{StaticResource Signal}" />
              <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Signal}" />
              <Setter Property="Foreground" Value="{StaticResource Ink}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon button: Tag holds the geometry key -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Path Data="{Binding}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="20" Height="20" Stretch="None" />
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An app in the Apps tab: the whole row opens it. Flat at rest, as a list is, with the usual
       hover and focus ring. -->
  <Style x:Key="AppRow" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- The star beside an app: hollow, or filled with the signal colour once the app is a favourite. -->
  <Style x:Key="StarToggle" TargetType="ToggleButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Path x:Name="Star" Data="{StaticResource IconStar}" Stroke="{StaticResource Muted}" Fill="Transparent" StrokeThickness="1.6"
                StrokeLineJoin="Round" Width="20" Height="20" Stretch="None" />
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
              <Setter TargetName="Star" Property="Fill" Value="{StaticResource Signal}" />
              <Setter TargetName="Star" Property="Stroke" Value="{StaticResource Signal}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The splitter between the phone and a second screen: a thin line in the gap, brighter while used. -->
  <Style x:Key="ViewSplitterThumb" TargetType="Thumb">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent">
            <Border x:Name="Line" Background="{StaticResource Line}" CornerRadius="2" Width="3" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,24" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Line" Property="Background" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Line" Property="Background" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Line" Property="Background" Value="{StaticResource Signal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Action tile: icon above label, used in the Controls grid. The label stays on one line and
       trims: a wrapped label made its row taller and, in a uniform grid, every other row with it.
       The whole label is the tile's tooltip and automation name. -->
  <Style x:Key="ActionTile" TargetType="Button" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="4,8" />
    <Setter Property="MinHeight" Value="58" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel>
            <Path Data="{Binding Icon}" Stroke="{StaticResource Signal}" StrokeThickness="1.6" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="None"
                  HorizontalAlignment="Center" Margin="0,0,0,5" />
            <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <!-- At least 44 x 32 of it answers the pointer, though the track it draws is 38 x 22. -->
          <Grid Background="Transparent" MinWidth="44" MinHeight="32">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" RecognizesAccessKey="False" />
            <!-- The border is always there, clear until focus paints it, so focus never moves the knob. -->
            <Border x:Name="Track" Grid.Column="1" Width="38" Height="22" CornerRadius="11" Background="{StaticResource Line}"
                    BorderBrush="Transparent" BorderThickness="1" VerticalAlignment="Center">
              <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="2,0,0,0" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Before IsChecked, so a switch that is on keeps its colour under the pointer. The row
                 around it lights the track too, since clicking anywhere on the row flips it. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource TrackHover}" />
            </Trigger>
            <Trigger Property="views:SettingRows.Hot" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource TrackHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Signal}" />
              <Setter TargetName="Knob" Property="Fill" Value="{StaticResource Ink}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Expander: a bold header with a chevron, the content indented underneath. The header's own
       ring shows keyboard focus; it reaches 7 DIP past the text on each side, into the room the side
       panel leaves around its content, so the words stay in line with the rows below. -->
  <Style TargetType="Expander">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" Cursor="Hand"
                          Foreground="{TemplateBinding Foreground}" FontSize="13" FontWeight="SemiBold" FocusVisualStyle="{x:Null}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6"
                          Padding="6,8" Margin="-7,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                      <Path x:Name="Chevron" Grid.Column="1" Data="M4 7 L9 12 L14 7" Stroke="{StaticResource Muted}" StrokeThickness="1.6"
                            Width="18" Height="18" Stretch="None" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                      </Path>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="180" />
                        </Setter.Value>
                      </Setter>
                      <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Signal}" />
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource Text}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Signal}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Content" Visibility="Collapsed" Margin="0,0,0,6" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Content" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Setting row: label + optional hint on the left, control on the right. A row holding a switch
       is one target: a click anywhere on it flips the switch (SettingRows). -->
  <Style x:Key="SettingRow" TargetType="HeaderedContentControl">
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="views:SettingRows.ClickToToggle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A row whose choices are too long to share a line with their label: the label above, the
       control below at full width, so neither is squeezed into a sliver. -->
  <Style x:Key="SettingRowStacked" TargetType="HeaderedContentControl" BasedOn="{StaticResource SettingRow}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="HeaderedContentControl">
          <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
            <StackPanel>
              <ContentPresenter ContentSource="Header" Margin="0,0,0,6" />
              <ContentPresenter />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inputs -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Field}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CaretBrush" Value="{StaticResource Signal}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Signal}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Muted}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                          Focusable="False" ClickMode="Press" Style="{StaticResource BaseButton}"
                          Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" Padding="0"
                          HorizontalContentAlignment="Stretch">
              <Grid Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Path Grid.Column="1" Data="M0 0 L4 4 L8 0" Stroke="{StaticResource Muted}" StrokeThickness="1.5" Margin="8,0,0,0" VerticalAlignment="Center" />
              </Grid>
            </ToggleButton>
            <Border x:Name="FocusRing" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" IsHitTestVisible="False" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   PopupAnimation="Fade" StaysOpen="False">
              <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                      MinWidth="{TemplateBinding ActualWidth}" Padding="4" Margin="0,4,0,0">
                <ScrollViewer MaxHeight="280">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="FocusRing" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Border" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Signal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Foreground" Value="{StaticResource Signal}" />
    <!-- The track is the Background (Line unless a slider paints its own, like the wash colour's
         rainbow) and the filled part is the Foreground. -->
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" Background="Transparent" />
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb x:Name="Knob" Width="16" Height="16" Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse Fill="{StaticResource Text}" Stroke="{StaticResource Ink}" StrokeThickness="2" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Knob" Property="Width" Value="20" />
              <Setter TargetName="Knob" Property="Height" Value="20" />
              <Setter TargetName="Knob" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect Color="{StaticResource SignalColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.9" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scrollbars. The track sizes its thumb from half of the system's arrow-button length, which
       left a 14 DIP sliver to aim at on a long panel in a small window; asking for 64 here keeps
       the thumb at least 32 DIP long. It fills the bar under the pointer and while dragged. -->
  <Style TargetType="ScrollBar">
    <Style.Resources>
      <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">64</sys:Double>
      <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">64</sys:Double>
    </Style.Resources>
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Focusable="False">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bar" Background="{StaticResource Line}" CornerRadius="4" Margin="1" />
                      <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                          <Setter TargetName="Bar" Property="Margin" Value="0" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{StaticResource Muted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Bar" Property="Background" Value="{StaticResource Muted}" />
                          <Setter TargetName="Bar" Property="Margin" Value="0" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="8" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Sidebar tab -->
  <Style x:Key="SidebarTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <!-- A clear border at rest, so the focus ring does not nudge the icon and label. -->
          <Border x:Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="0,7" Margin="2,0">
            <StackPanel>
              <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="None" HorizontalAlignment="Center" />
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Raised}" />
              <Setter Property="Foreground" Value="{StaticResource Signal}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Signal}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented choice (lock mode, rotation) -->
  <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource BaseButton}">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FontSize" Value="12" />
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{StaticResource Signal}" />
        <Setter Property="BorderBrush" Value="{StaticResource Signal}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource Raised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Menus: the phone picker, and the Cut / Copy / Paste menu every text box opens on a right
       click. Left to Windows they come up light and square in a dark window. -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="True" />
    <Setter Property="Grid.IsSharedSizeScope" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="10" Padding="4" MinWidth="220" Margin="0,6,0,0" SnapsToDevicePixels="True">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Padding" Value="8,7,12,7" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Border" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
              </Grid.ColumnDefinitions>
              <Path x:Name="Check" Data="M1 6 L5 10 L12 2" Stroke="{StaticResource Signal}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Hidden" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource Muted}"
                         FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="{StaticResource Raised}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{StaticResource Line}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A flat bar in the app's colours instead of the system's animated green one. -->
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Signal}" />
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The side panel's resize handle: invisible until the pointer or keyboard reaches it, so it
       says it can be dragged exactly when that is useful, and stays lit while it is. -->
  <Style x:Key="PanelSplitter" TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border Background="Transparent">
            <Border x:Name="Grip" Width="2" CornerRadius="1" HorizontalAlignment="Center" Background="{StaticResource Signal}" Opacity="0" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="0.8" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Grip" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
