<Window x:Class="Rex.Mirror.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mirror="clr-namespace:Rex.Mirror.Mirror"
        xmlns:views="clr-namespace:Rex.Mirror.Views"
        Title="Android Headless Mirror"
        Width="1180" Height="780" MinWidth="720" MinHeight="480"
        Background="{StaticResource Ink}"
        Foreground="{StaticResource Text}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Top bar -->
    <Border x:Name="TopBar" Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Height="54" Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Path Data="{StaticResource IconPhone}" Stroke="{StaticResource Signal}" StrokeThickness="1.7" Width="18" Height="18" Stretch="Uniform" />
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="REX" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Signal}" />
            <TextBlock Text="Android Headless Mirror" FontSize="13" FontWeight="SemiBold" Margin="0,-1,0,0" />
          </StackPanel>
        </StackPanel>

        <Border x:Name="DeviceChip" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16"
                Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12,6" Margin="16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="DeviceName" Text="No phone connected" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock x:Name="DeviceMeta" Text="" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="QuickHome" Style="{StaticResource IconButton}" Content="{StaticResource IconHome}" ToolTip="Home" Click="OnQuickAction" Tag="home" />
          <Button x:Name="QuickBack" Style="{StaticResource IconButton}" Content="{StaticResource IconBack}" ToolTip="Back" Click="OnQuickAction" Tag="back" />
          <Button x:Name="QuickRecents" Style="{StaticResource IconButton}" Content="{StaticResource IconRecents}" ToolTip="Recent apps" Click="OnQuickAction" Tag="recents" />
          <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="6,0" />
          <Button x:Name="QuickSleep" Style="{StaticResource IconButton}" Content="{StaticResource IconMoon}" ToolTip="Turn the phone screen off (mirror keeps running)" Click="OnQuickAction" Tag="sleep" />
          <Button x:Name="QuickScreenshot" Style="{StaticResource IconButton}" Content="{StaticResource IconCamera}" ToolTip="Save a screenshot" Click="OnQuickAction" Tag="screenshot" />
          <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="6,0" />
          <Button x:Name="ZoomBadge" Style="{StaticResource GhostButton}" Padding="8,4" MinHeight="28" ToolTip="Reset zoom (Alt + wheel or Alt + pinch to zoom, Alt + drag to pan)"
                  Click="OnQuickAction" Tag="zoom-reset" Visibility="Collapsed">
            <TextBlock x:Name="ZoomText" Text="100%" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Signal}" />
          </Button>
          <Button x:Name="SidebarToggle" Style="{StaticResource IconButton}" Content="{StaticResource IconSidebar}" ToolTip="Show or hide the side panel" Click="OnToggleSidebar" />
          <Button x:Name="FullscreenButton" Style="{StaticResource IconButton}" Content="{StaticResource IconFullscreen}" ToolTip="Fullscreen (F11)" Click="OnToggleFullscreen" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Notice bar: one question or hint at a time, never a dialog -->
    <Border x:Name="NoticeBar" Grid.Row="1" Background="{StaticResource SignalWash}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="NoticeTitle" FontWeight="SemiBold" Text="How does this phone unlock?" />
          <TextBlock x:Name="NoticeText" Style="{StaticResource MutedText}" Text="Pattern phones get a nine-dot guide when the lock screen shows black. Nothing about the pattern itself is stored." Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel x:Name="NoticeActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button Content="Pattern" Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="12,4" Margin="0,0,6,0" Click="OnLockAnswer" Tag="pattern" />
          <Button Content="PIN, password or other" MinHeight="30" Padding="12,4" Margin="0,0,6,0" Click="OnLockAnswer" Tag="other" />
          <Button Content="No lock" MinHeight="30" Padding="12,4" Margin="0,0,6,0" Click="OnLockAnswer" Tag="none" />
          <Button Content="Later" Style="{StaticResource GhostButton}" MinHeight="30" Padding="10,4" Click="OnLockAnswer" Tag="later" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid x:Name="Body" Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="SidebarColumn" Width="330" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="MirrorArea" Background="{StaticResource Ink}">
        <mirror:MirrorHost x:Name="Host" />
        <Grid x:Name="EmptyState" Background="{StaticResource Ink}">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,22">
              <Ellipse x:Name="EmptyHalo" Fill="{StaticResource SignalWash}" />
              <Path Data="{StaticResource IconPhone}" Stroke="{StaticResource Signal}" StrokeThickness="1.4" Width="44" Height="44" Stretch="Uniform" />
            </Grid>
            <TextBlock x:Name="EmptyTitle" Text="Connect your phone" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" />
            <TextBlock x:Name="EmptyText" Text="Plug in an Android phone with USB debugging turned on. It appears here automatically." Style="{StaticResource MutedText}" FontSize="13" TextAlignment="Center" Margin="0,8,0,18" />
            <StackPanel x:Name="EmptyActions" Orientation="Horizontal" HorizontalAlignment="Center">
              <Button x:Name="EmptyPrimary" Content="Start mirror" Style="{StaticResource PrimaryButton}" Click="OnEmptyPrimary" Visibility="Collapsed" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>

      <Border x:Name="Sidebar" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <UniformGrid Rows="1" Margin="8,8,8,4">
            <RadioButton x:Name="TabControls" Style="{StaticResource SidebarTab}" Content="Controls" Tag="{StaticResource IconSliders}" IsChecked="True" Checked="OnTabChecked" />
            <RadioButton x:Name="TabPhone" Style="{StaticResource SidebarTab}" Content="Phone" Tag="{StaticResource IconPhone}" Checked="OnTabChecked" />
            <RadioButton x:Name="TabSettings" Style="{StaticResource SidebarTab}" Content="Settings" Tag="{StaticResource IconSettings}" Checked="OnTabChecked" />
            <RadioButton x:Name="TabInfo" Style="{StaticResource SidebarTab}" Content="Info" Tag="{StaticResource IconInfo}" Checked="OnTabChecked" />
          </UniformGrid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,4,16,16">
            <Grid>
              <views:ControlsPanel x:Name="ControlsPanel" />
              <views:PhonePanel x:Name="PhonePanel" Visibility="Collapsed" />
              <views:SettingsPanel x:Name="SettingsPanel" Visibility="Collapsed" />
              <views:InfoPanel x:Name="InfoPanel" Visibility="Collapsed" />
            </Grid>
          </ScrollViewer>
        </Grid>
      </Border>

      <views:OnboardingView x:Name="Onboarding" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>

    <!-- Status bar -->
    <Border x:Name="StatusBar" Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Height="28" Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="Starting…" />
        <TextBlock x:Name="HintText" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Text="Alt + wheel zoom · Alt + drag pan · F11 fullscreen" />
      </Grid>
    </Border>
  </Grid>
</Window>
