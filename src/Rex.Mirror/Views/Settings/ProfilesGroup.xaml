<UserControl x:Class="Rex.Mirror.Views.Settings.ProfilesGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupProfiles" Header="Profiles" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="A profile is a list of settings to switch to in one go: one for games, one for films, one for battery. Applying one changes only the settings in it." />
    <TextBlock x:Name="ProfilesNow" TextWrapping="Wrap" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
    <StackPanel x:Name="ProfilesList" Margin="0,6,0,0" />
    <TextBlock x:Name="ProfilesEmpty" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
               Text="No profiles yet. Save the settings you have now, or start from a preset below." />

    <Button x:Name="ProfilesSave" Content="Save the current settings as a profile…" Margin="0,8,0,0" Click="OnShowSave" />
    <Border x:Name="ProfilesSaveForm" Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
            Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="ProfileNameLabel" Text="Name" />
        <TextBox x:Name="ProfileName" Margin="0,4,0,0" AutomationProperties.LabeledBy="{Binding ElementName=ProfileNameLabel}" TextChanged="OnNameTyped" KeyDown="OnNameKey" />
        <TextBlock x:Name="ProfileNameProblem" Style="{StaticResource MutedText}" Foreground="{StaticResource Live}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ProfileGroupsLabel" Text="The settings in it" Margin="0,10,0,4" />
        <WrapPanel x:Name="ProfileGroups" />
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Only what differs from how the app ships">
          <CheckBox x:Name="ProfilesOnlyChanged" IsChecked="True" Checked="OnOnlyChanged" Unchecked="OnOnlyChanged" />
        </HeaderedContentControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
          <Button x:Name="ProfilesSaveCancel" Content="Cancel" Margin="0,0,8,0" Click="OnCancelSave" />
          <Button x:Name="ProfilesSaveConfirm" Content="Save" Style="{StaticResource PrimaryButton}" Click="OnSave" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Text="START FROM A PRESET" Style="{StaticResource Eyebrow}" />
    <ComboBox x:Name="ProfilesPreset" SelectionChanged="OnPresetChosen" AutomationProperties.Name="Preset" />
    <TextBlock x:Name="ProfilesPresetChanges" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
    <UniformGrid Columns="2" Margin="-3,6,-3,0">
      <Button x:Name="ProfilesPresetApply" Content="Apply" Margin="3,0" Click="OnPresetApply" />
      <Button x:Name="ProfilesPresetSave" Content="Save as my own" Margin="3,0" Click="OnPresetSave" />
    </UniformGrid>
    <Button x:Name="ProfilesImport" Content="Import a profile…" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnImport" />

    <TextBlock Text="SWITCHING BY THEMSELVES" Style="{StaticResource Eyebrow}" />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="In fullscreen use">
      <ComboBox x:Name="ProfilesFullscreen" SelectionChanged="OnOption" AutomationProperties.Name="In fullscreen use" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="On battery use">
      <ComboBox x:Name="ProfilesBattery" SelectionChanged="OnOption" AutomationProperties.Name="On battery use" ToolTipService.ShowOnDisabled="True" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Use each phone's own profile when it connects"><CheckBox x:Name="ProfilesPerPhone" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Put back what an automatic profile changed when it ends"><CheckBox x:Name="ProfilesPutBack" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Say when a profile switches by itself"><CheckBox x:Name="ProfilesAnnounce" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="When a profile changes how the mirror starts">
      <ComboBox x:Name="ProfilesAfter" SelectionChanged="OnOption" AutomationProperties.Name="When a profile changes how the mirror starts">
        <ComboBoxItem Content="Offer a restart" Tag="offer" />
        <ComboBoxItem Content="Restart the mirror at once" Tag="restart" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Ctrl+Alt+F1 to F9 apply profiles 1 to 9"><CheckBox x:Name="ProfilesKeys" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Profiles in the tray menu"><CheckBox x:Name="ProfilesInTray" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
  </StackPanel></Expander>
</UserControl>
