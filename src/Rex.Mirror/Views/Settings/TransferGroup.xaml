<UserControl x:Class="Rex.Mirror.Views.Settings.TransferGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupFiles" Header="Files" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Drop, choose or paste files to copy them into the phone's shared storage. APK files may be installed instead." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Accept files from this PC"><CheckBox x:Name="TransferEnabled" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <StackPanel x:Name="TransferOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Send files to">
        <TextBox x:Name="TransferFolder" LostFocus="OnFolder" KeyDown="OnFolderKey" AutomationProperties.Name="Send files to" />
      </HeaderedContentControl>
      <TextBlock x:Name="TransferFolderError" Foreground="{StaticResource Live}" FontSize="11" TextWrapping="Wrap" />
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Put photos, videos and music in their own folders"><CheckBox x:Name="TransferSortMedia" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Dropped folders">
        <ComboBox x:Name="TransferFolders" SelectionChanged="OnOption"><ComboBoxItem Content="Send the whole folder" Tag="send" /><ComboBoxItem Content="Refuse folders" Tag="refuse" /></ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Install apps (.apk) instead of copying them"><CheckBox x:Name="TransferInstallApks" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <StackPanel x:Name="TransferInstallOptions">
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Update an app that is already installed"><CheckBox x:Name="TransferReplace" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Allow installing an older version"><CheckBox x:Name="TransferAllowDowngrade" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Grant every permission the app asks for"><CheckBox x:Name="TransferGrantPermissions" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Allow test builds"><CheckBox x:Name="TransferAllowTestApps" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Ask before installing"><CheckBox x:Name="TransferConfirmInstall" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Open an app once it is installed"><CheckBox x:Name="TransferOpenAfterInstall" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      </StackPanel>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Ask before sending anything dropped"><CheckBox x:Name="TransferConfirmDrops" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Ask before sending more than">
        <ComboBox x:Name="TransferConfirmOver" SelectionChanged="OnOption"><ComboBoxItem Content="Never" Tag="0" /><ComboBoxItem Content="100 MB" Tag="100" /><ComboBoxItem Content="500 MB" Tag="500" /><ComboBoxItem Content="1 GB" Tag="1024" /><ComboBoxItem Content="4 GB" Tag="4096" /><ComboBoxItem Content="10 GB" Tag="10240" /></ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="When the phone already has a file with that name">
        <ComboBox x:Name="TransferWhenExists" SelectionChanged="OnOption"><ComboBoxItem Content="Ask" Tag="ask" /><ComboBoxItem Content="Keep both" Tag="rename" /><ComboBoxItem Content="Replace" Tag="replace" /><ComboBoxItem Content="Skip" Tag="skip" /></ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show new photos and videos in the Gallery at once"><CheckBox x:Name="TransferScanMedia" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Open the folder on the phone afterwards"><CheckBox x:Name="TransferShowFolderAfter" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <Grid Margin="0,8,0,0"><TextBlock x:Name="TransferAtOnceLabel" Text="Send this many files at once" /><TextBlock x:Name="TransferAtOnceValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="TransferAtOnce" AutomationProperties.LabeledBy="{Binding ElementName=TransferAtOnceLabel}" Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSlider" />
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show progress on the taskbar button"><CheckBox x:Name="TransferTaskbar" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Say when it is done while the window is hidden"><CheckBox x:Name="TransferNotifyHidden" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Cancel what is waiting when the phone disconnects"><CheckBox x:Name="TransferCancelOnLeave" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
      <Grid Margin="0,8,0,0"><TextBlock x:Name="TransferHistoryLabel" Text="Keep this many finished transfers in the list" /><TextBlock x:Name="TransferHistoryValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="TransferHistory" AutomationProperties.LabeledBy="{Binding ElementName=TransferHistoryLabel}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnSlider" />
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel><TextBlock Text="Add Send to › Android phone to File Explorer" /><TextBlock Text="Appears in File Explorer's Send to menu." Style="{StaticResource MutedText}" FontSize="11" /></StackPanel></HeaderedContentControl.Header>
        <CheckBox x:Name="TransferSendToMenu" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Add Send to Android phone to File Explorer" />
      </HeaderedContentControl>
    </StackPanel>
  </StackPanel></Expander>
</UserControl>
