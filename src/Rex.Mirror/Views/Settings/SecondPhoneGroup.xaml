<UserControl x:Class="Rex.Mirror.Views.Settings.SecondPhoneGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupSecondPhone" Header="Second phone" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="A second, different phone beside the first, each in a view of its own. The side panel, keys and buttons act on the one you click. Copies wait while two phones show." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show a second phone beside the first">
      <CheckBox x:Name="SecondPhoneEnabled" Checked="OnOption" Unchecked="OnOption" />
    </HeaderedContentControl>
    <StackPanel x:Name="SecondPhoneOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="When a second phone connects">
        <ComboBox x:Name="SecondPhoneWhen" SelectionChanged="OnOption" AutomationProperties.Name="When a second phone connects">
          <ComboBoxItem Content="Ask in the notice bar" Tag="ask" />
          <ComboBoxItem Content="Show it beside at once" Tag="always" />
          <ComboBoxItem Content="Only from the phone menu" Tag="never" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel>
          <TextBlock Text="Show the same second phone again next time" TextWrapping="Wrap" />
          <TextBlock Text="The one shown beside comes back by itself when it connects again." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel></HeaderedContentControl.Header>
        <CheckBox x:Name="SecondPhoneRemember" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Show the same second phone again next time" />
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="On which side">
        <ComboBox x:Name="SecondPhoneSide" SelectionChanged="OnOption" AutomationProperties.Name="On which side">
          <ComboBoxItem Content="Right of the main phone" Tag="right" />
          <ComboBoxItem Content="Left of the main phone" Tag="left" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Sound on this PC from">
        <ComboBox x:Name="SecondPhoneSound" SelectionChanged="OnOption" AutomationProperties.Name="Sound on this PC from">
          <ComboBoxItem Content="The main phone" Tag="main" />
          <ComboBoxItem Content="The phone you are using" Tag="active" />
          <ComboBoxItem Content="Both phones" Tag="both" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Its own screen while shown">
        <ComboBox x:Name="SecondPhoneScreenOff" SelectionChanged="OnOption" AutomationProperties.Name="Its own screen while shown">
          <ComboBoxItem Content="Like the main phone" Tag="same" />
          <ComboBoxItem Content="Off" Tag="off" />
          <ComboBoxItem Content="On" Tag="on" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Its resolution limit">
        <ComboBox x:Name="SecondPhoneMaxSize" SelectionChanged="OnOption" AutomationProperties.Name="Its resolution limit">
          <ComboBoxItem Content="Like the main phone" Tag="0" />
          <ComboBoxItem Content="480 px" Tag="480" />
          <ComboBoxItem Content="720 px" Tag="720" />
          <ComboBoxItem Content="1024 px" Tag="1024" />
          <ComboBoxItem Content="1280 px" Tag="1280" />
          <ComboBoxItem Content="1600 px" Tag="1600" />
          <ComboBoxItem Content="1920 px" Tag="1920" />
          <ComboBoxItem Content="2560 px" Tag="2560" />
          <ComboBoxItem Content="3840 px" Tag="3840" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Its bit rate">
        <ComboBox x:Name="SecondPhoneBitRate" SelectionChanged="OnOption" AutomationProperties.Name="Its bit rate">
          <ComboBoxItem Content="Like the main phone" Tag="" />
          <ComboBoxItem Content="4 Mbps" Tag="4M" />
          <ComboBoxItem Content="8 Mbps" Tag="8M" />
          <ComboBoxItem Content="12 Mbps" Tag="12M" />
          <ComboBoxItem Content="16 Mbps" Tag="16M" />
          <ComboBoxItem Content="24 Mbps" Tag="24M" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel>
          <TextBlock Text="Pause it while the window is hidden" TextWrapping="Wrap" />
          <TextBlock Text="It stops after five seconds out of sight and starts again when the window shows." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel></HeaderedContentControl.Header>
        <CheckBox x:Name="SecondPhonePause" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Pause it while the window is hidden" />
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel>
          <TextBlock Text="Its own profile applies while you use it" TextWrapping="Wrap" />
          <TextBlock Text="The profile chosen for that phone, put back when you go back to the main one." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel></HeaderedContentControl.Header>
        <CheckBox x:Name="SecondPhoneProfile" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Its own profile applies while you use it" />
      </HeaderedContentControl>
    </StackPanel>
  </StackPanel></Expander>
</UserControl>
