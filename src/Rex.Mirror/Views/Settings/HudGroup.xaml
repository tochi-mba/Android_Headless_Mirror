<UserControl x:Class="Rex.Mirror.Views.Settings.HudGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupHud" Header="Fullscreen controls" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
               Text="In fullscreen the controls hide themselves. Move the pointer to where you put them and they come back. Drag them anywhere by the dotted grip on their left." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show the floating controls"><CheckBox x:Name="HudEnabled" Checked="OnHudChanged" Unchecked="OnHudChanged" /></HeaderedContentControl>
    <StackPanel x:Name="HudOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Where they sit">
        <ComboBox x:Name="HudPosition" SelectionChanged="OnHudPosition">
          <ComboBoxItem Content="Top" Tag="top" /><ComboBoxItem Content="Bottom" Tag="bottom" />
          <ComboBoxItem Content="Left" Tag="left" /><ComboBoxItem Content="Right" Tag="right" />
          <ComboBoxItem Content="Top left" Tag="top-left" /><ComboBoxItem Content="Top right" Tag="top-right" />
          <ComboBoxItem Content="Bottom left" Tag="bottom-left" /><ComboBoxItem Content="Bottom right" Tag="bottom-right" />
        </ComboBox>
      </HeaderedContentControl>
      <Grid x:Name="HudDraggedRow" Margin="0,2,0,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Text="Dragged to a spot of their own." />
        <Button x:Name="HudPinBack" Content="Pin it back" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="OnHudPinBack" ToolTip="Put the controls back where the position above says." />
      </Grid>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show the status line under them"><CheckBox x:Name="HudMessages" Checked="OnHudChanged" Unchecked="OnHudChanged" /></HeaderedContentControl>
      <Grid Margin="0,10,0,0"><TextBlock Text="Size" /><TextBlock x:Name="HudScaleValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudScale" AutomationProperties.Name="Fullscreen controls size" Minimum="0.75" Maximum="1.75" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <Grid Margin="0,8,0,0"><TextBlock Text="Opacity" /><TextBlock x:Name="HudOpacityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudOpacity" AutomationProperties.Name="Fullscreen controls opacity" Minimum="0.3" Maximum="1" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <Grid Margin="0,8,0,0"><TextBlock Text="Hides after" /><TextBlock x:Name="HudDelayValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudDelay" AutomationProperties.Name="Fullscreen controls hide delay" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <TextBlock Text="Buttons" Margin="0,14,0,0" />
      <TextBlock x:Name="HudButtonCount" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,6" Text="Tap to add or remove. They appear in this order." TextWrapping="Wrap" />
      <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,7" Margin="0,0,0,10"><StackPanel>
        <TextBlock Text="PREVIEW" Style="{StaticResource Eyebrow}" FontSize="11" Margin="2,0,0,6" /><WrapPanel x:Name="HudPreview" />
      </StackPanel></Border>
      <WrapPanel x:Name="HudButtons" />
      <Button Content="Reset the fullscreen controls" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetHud" />
    </StackPanel>
  </StackPanel></Expander>
</UserControl>
