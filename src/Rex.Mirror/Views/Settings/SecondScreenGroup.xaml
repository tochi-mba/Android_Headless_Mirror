<UserControl x:Class="Rex.Mirror.Views.Settings.SecondScreenGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupScreen" Header="Second screen &amp; views" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="One app on a display of its own, beside the phone or instead of it. Changes here open it again with the same app. Needs Android 10 or later." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show it">
      <ComboBox x:Name="ScreenPlacement" SelectionChanged="OnOption" AutomationProperties.Name="Show it">
        <ComboBoxItem Content="Beside the phone" Tag="beside" />
        <ComboBoxItem Content="Instead of the phone" Tag="instead" />
      </ComboBox>
    </HeaderedContentControl>
    <StackPanel x:Name="ScreenBesideOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="On which side">
        <ComboBox x:Name="ScreenSide" SelectionChanged="OnOption" AutomationProperties.Name="On which side">
          <ComboBoxItem Content="Right of the phone" Tag="right" />
          <ComboBoxItem Content="Left of the phone" Tag="left" />
        </ComboBox>
      </HeaderedContentControl>
      <Grid Margin="0,8,0,0"><TextBlock x:Name="ScreenMinWidthLabel" Text="Never narrower than" /><TextBlock x:Name="ScreenMinWidthValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="ScreenMinWidth" AutomationProperties.LabeledBy="{Binding ElementName=ScreenMinWidthLabel}" Minimum="240" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnSlider"
              ToolTip="Below this, the phone's view shrinks first; then the second screen shows alone until there is room." />
    </StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Size">
      <ComboBox x:Name="ScreenSize" SelectionChanged="OnOption" AutomationProperties.Name="Size">
        <ComboBoxItem Content="Fits the window exactly" Tag="follow" />
        <ComboBoxItem Content="Same as the phone" Tag="phone" />
        <ComboBoxItem Content="1280 x 720" Tag="720p" />
        <ComboBoxItem Content="1920 x 1080" Tag="1080p" />
        <ComboBoxItem Content="2560 x 1440" Tag="1440p" />
        <ComboBoxItem Content="Your own" Tag="custom" />
      </ComboBox>
    </HeaderedContentControl>
    <Grid x:Name="ScreenCustomOptions" Margin="0,8,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="ScreenCustomWidth" AutomationProperties.Name="Width in pixels" ToolTip="320 to 3840 pixels" LostFocus="OnCustomSize" KeyDown="OnCustomSizeKey" />
      <TextBlock Grid.Column="1" Text="x" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0" />
      <TextBox x:Name="ScreenCustomHeight" Grid.Column="2" AutomationProperties.Name="Height in pixels" ToolTip="320 to 3840 pixels" LostFocus="OnCustomSize" KeyDown="OnCustomSizeKey" />
    </Grid>
    <StackPanel x:Name="ScreenFixedOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel>
          <TextBlock Text="Upright" TextWrapping="Wrap" />
          <TextBlock Text="Off, a fixed size lies on its side, as a PC screen does." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel></HeaderedContentControl.Header>
        <CheckBox x:Name="ScreenPortrait" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Upright" />
      </HeaderedContentControl>
    </StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Resize it while the window is being resized" TextWrapping="Wrap" />
        <TextBlock Text="Off, it takes the new size once the drag ends." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ScreenResizeWhileDragging" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Resize it while the window is being resized" />
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="ScreenDpiLabel" Text="Text and buttons" /><TextBlock x:Name="ScreenDpiValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="ScreenDpi" AutomationProperties.LabeledBy="{Binding ElementName=ScreenDpiLabel}" Minimum="80" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnSlider"
            ToolTip="Smaller to the left, larger to the right; all the way left is the phone's own." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Video resolution limit">
      <ComboBox x:Name="ScreenMaxSize" SelectionChanged="OnOption" AutomationProperties.Name="Video resolution limit">
        <ComboBoxItem Content="No limit" Tag="0" />
        <ComboBoxItem Content="480 px" Tag="480" />
        <ComboBoxItem Content="720 px" Tag="720" />
        <ComboBoxItem Content="1024 px" Tag="1024" />
        <ComboBoxItem Content="1280 px" Tag="1280" />
        <ComboBoxItem Content="1600 px" Tag="1600" />
        <ComboBoxItem Content="1920 px" Tag="1920" />
        <ComboBoxItem Content="2560 px" Tag="2560" />
        <ComboBoxItem Content="3840 px" Tag="3840" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Android's navigation bar on it"><CheckBox x:Name="ScreenDecorations" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Closing it moves its app to the phone" TextWrapping="Wrap" />
        <TextBlock Text="Off, closing it closes the app too." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ScreenKeepApps" Checked="OnOption" Unchecked="OnOption" AutomationProperties.Name="Closing it moves its app to the phone" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Android's on-screen keyboard appears">
      <ComboBox x:Name="ScreenKeyboard" SelectionChanged="OnOption" AutomationProperties.Name="Android's on-screen keyboard appears">
        <ComboBoxItem Content="On the second screen" Tag="here" />
        <ComboBoxItem Content="On the phone's own screen" Tag="phone" />
        <ComboBoxItem Content="Never: type on this PC" Tag="never" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Open it again with the last app when the mirror starts"><CheckBox x:Name="ScreenReopen" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>

    <TextBlock Text="VIEWS" Style="{StaticResource Eyebrow}" />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Arrange the views">
      <ComboBox x:Name="ViewsArrangement" SelectionChanged="OnOption" AutomationProperties.Name="Arrange the views">
        <ComboBoxItem Content="Whatever fits best" Tag="auto" />
        <ComboBoxItem Content="Side by side" Tag="side" />
        <ComboBoxItem Content="One above the other" Tag="stack" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Outline the view that has the keyboard">
      <ComboBox x:Name="ViewsOutline" SelectionChanged="OnOption" AutomationProperties.Name="Outline the view that has the keyboard">
        <ComboBoxItem Content="When there is more than one" Tag="auto" />
        <ComboBoxItem Content="Always" Tag="always" />
        <ComboBoxItem Content="Never" Tag="never" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Name each view">
      <ComboBox x:Name="ViewsCaptions" SelectionChanged="OnOption" AutomationProperties.Name="Name each view">
        <ComboBoxItem Content="When they show different things" Tag="auto" />
        <ComboBoxItem Content="Always" Tag="always" />
        <ComboBoxItem Content="Never" Tag="never" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="A splitter between the phone and the second screen"><CheckBox x:Name="ViewsSplitter" Checked="OnOption" Unchecked="OnOption" /></HeaderedContentControl>
  </StackPanel></Expander>
</UserControl>
