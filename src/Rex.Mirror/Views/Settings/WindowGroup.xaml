<UserControl x:Class="Rex.Mirror.Views.Settings.WindowGroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Expander x:Name="GroupWindow" Header="Window" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="How the window looks and where it opens. Everything here applies at once." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep the window on top">
      <CheckBox x:Name="AlwaysOnTop" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Keep the window on top" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Side panel">
      <ComboBox x:Name="SidebarSide" SelectionChanged="OnChanged" AutomationProperties.Name="Side panel position">
        <ComboBoxItem Content="On the right" Tag="right" />
        <ComboBoxItem Content="On the left" Tag="left" />
      </ComboBox>
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="PanelScaleLabel" Text="Side panel size" /><TextBlock x:Name="PanelScaleValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="PanelScale" AutomationProperties.LabeledBy="{Binding ElementName=PanelScaleLabel}" Minimum="0.8" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True"
            SmallChange="0.05" LargeChange="0.1" Margin="0,2,0,0" ValueChanged="OnScale"
            ToolTip="Its text and controls larger or smaller; the panel keeps its width." />
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Around the picture" />
        <TextBlock Text="The mirror area changes at once; the edges scrcpy draws itself, at the mirror's next start." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <ComboBox x:Name="Backdrop" SelectionChanged="OnChanged" AutomationProperties.Name="Around the picture">
        <ComboBoxItem Content="The app's own dark" Tag="ink" />
        <ComboBoxItem Content="Black, for an OLED screen" Tag="black" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Live pictures without a graphics card" />
        <TextBlock x:Name="WithoutGraphicsCardHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                   Text="The soft background and the navigator's picture, over Remote Desktop or in a virtual machine, where each frame is drawn by the processor." />
      </StackPanel></HeaderedContentControl.Header>
      <ComboBox x:Name="WithoutGraphicsCard" SelectionChanged="OnChanged" AutomationProperties.Name="Live pictures without a graphics card">
        <ComboBoxItem Content="Slower, a few times a second" Tag="slower" />
        <ComboBoxItem Content="As often as set" Tag="same" />
        <ComboBoxItem Content="Off" Tag="off" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Top bar" />
        <TextBlock Text="The phone's name and its buttons. Without it, Ctrl+Alt+B still shows the side panel." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ShowTopBar" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Top bar" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRowStacked}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Phone buttons in the top bar" />
          <TextBlock Text="Tap to show or hide each one." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <WrapPanel x:Name="QuickButtonChoices" Margin="0,4,0,0" />
    </HeaderedContentControl>
    <!-- One row for the search: any other action in the top bar, and adding one. -->
    <StackPanel Tag="row">
      <TextBlock Text="More buttons in the top bar" Margin="0,10,0,0" />
      <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="Any action, after the phone buttons, in the order you add them." />
      <StackPanel x:Name="TopBarExtraList" AutomationProperties.Name="More buttons in the top bar" />
    </StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Status bar" />
        <TextBlock Text="What the app is doing, under the mirror." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ShowStatusBar" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Status bar" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Shortcut hints in the status bar">
      <CheckBox x:Name="ShowHints" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Shortcut hints in the status bar" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Frame rate in the status bar" />
          <TextBlock Text="Live, from scrcpy's own counter." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="ShowFrameRate" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Frame rate in the status bar" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Open where it was last time" />
        <TextBlock Text="Off opens it in the middle of the screen at its usual size." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="RememberPlacement" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Open where it was last time" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Fit the window to the phone as the mirror starts" TextWrapping="Wrap" />
        <TextBlock x:Name="FitWindowHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="FitWindowOnStart" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Fit the window to the phone as the mirror starts" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Ask before quitting while a phone is mirrored" TextWrapping="Wrap" />
        <TextBlock Text="From the tray's Quit, or closing the window when nothing stays in the tray." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ConfirmQuit" Checked="OnChanged" Unchecked="OnChanged" AutomationProperties.Name="Ask before quitting while a phone is mirrored" />
    </HeaderedContentControl>
  </StackPanel></Expander>
</UserControl>
