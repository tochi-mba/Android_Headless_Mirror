<UserControl x:Class="Rex.Mirror.Views.AdvancedSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <!-- One warning, here, rather than a second one above the view. -->
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
               Text="Every key in Android's settings provider, including the ones above. Editing here is unguided: keys that could cut off ADB are refused, and Android may refuse others." />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="Namespace" SelectedIndex="0" SelectionChanged="OnNamespace"
               AutomationProperties.Name="Settings namespace" ToolTip="Which of Android's three settings tables to read">
        <ComboBoxItem Content="system" Tag="system" />
        <ComboBoxItem Content="secure" Tag="secure" />
        <ComboBoxItem Content="global" Tag="global" />
      </ComboBox>
      <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="{StaticResource IconRefresh}" Click="OnReload" Margin="6,0,0,0"
              AutomationProperties.Name="Reload" ToolTip="Read every key from the phone again" />
    </Grid>
    <Grid Margin="0,6,0,0">
      <TextBox x:Name="Search" TextChanged="OnSearch" AutomationProperties.Name="Filter keys" ToolTip="Show only the keys and values that mention this" />
      <TextBlock x:Name="SearchHint" Style="{StaticResource MutedText}" Text="Filter keys and values" Margin="10,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <Border Margin="0,8,0,0" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Ink}">
      <ListBox x:Name="Rows" MaxHeight="260" Background="Transparent" BorderThickness="0" SelectionChanged="OnRowSelected"
               PreviewMouseWheel="OnRowsWheel" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="Border" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Border" Property="Background" Value="{StaticResource Hover}" />
                    </Trigger>
                    <!-- After the hover trigger, so the chosen row stays marked under the pointer. -->
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="Border" Property="Background" Value="{StaticResource Raised}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                      <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Signal}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{Binding Value}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding RiskTag}" FontSize="10" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <!-- Full width, each with a hint inside it: side by side they were 64 DIP wide and unlabelled. -->
    <Grid Margin="0,8,0,0">
      <TextBox x:Name="Key" TextChanged="OnFieldText" AutomationProperties.Name="Key" ToolTip="The Android settings key, for example screen_brightness" />
      <TextBlock x:Name="KeyHint" Style="{StaticResource MutedText}" Text="Key, for example screen_brightness" Margin="10,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <Grid Margin="0,6,0,0">
      <TextBox x:Name="Value" TextChanged="OnFieldText" AutomationProperties.Name="Value" ToolTip="What to write into that key" />
      <TextBlock x:Name="ValueHint" Style="{StaticResource MutedText}" Text="Value to write" Margin="10,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <UniformGrid Columns="2" Margin="-3,8,-3,0">
      <Button x:Name="WriteButton" Content="Write" Style="{StaticResource PrimaryButton}" Margin="3,0" Click="OnWrite"
              ToolTip="Put this value into the key on the phone" />
      <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource DangerButton}" Margin="3,0" Click="OnDelete"
              ToolTip="Remove the key so Android uses its own default" />
    </UniformGrid>
    <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
  </StackPanel>
</UserControl>
