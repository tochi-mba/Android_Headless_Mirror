<UserControl x:Class="Rex.Mirror.Views.AppsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewTextInput="OnTyping" PreviewKeyDown="OnKey">
  <StackPanel>
    <TextBlock x:Name="Unavailable" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap"
               Text="Connect a phone to see its apps." />

    <StackPanel x:Name="Body">
      <!-- While an app is being chosen for the second screen, the tab says so and a click opens it there. -->
      <Border x:Name="ChoosingBanner" Background="{StaticResource SignalWash}" BorderBrush="{StaticResource Signal}" BorderThickness="1" CornerRadius="8"
              Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ChoosingText" Text="Choose an app for the second screen" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="ChoosingCancel" Grid.Column="1" Content="Cancel" Margin="8,0,0,0" Padding="10,3" MinHeight="28" Click="OnChoosingCancel"
                  ToolTip="Stop choosing · Esc" />
        </Grid>
      </Border>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid>
          <TextBox x:Name="AppsSearch" TextChanged="OnSearch" AutomationProperties.Name="Find an app"
                   ToolTip="By its name or its package · Esc clears it" />
          <TextBlock x:Name="SearchHint" Style="{StaticResource MutedText}" Text="Find an app"
                     Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <Button x:Name="AppsReadAgain" Grid.Column="1" Content="Read again" Margin="6,0,0,0" Click="OnReadAgain"
                ToolTip="Read the phone's apps again" ToolTipService.ShowOnDisabled="True" />
      </Grid>
      <TextBlock x:Name="AppsInfo" Style="{StaticResource MutedText}" FontSize="11" Margin="2,4,0,0" TextTrimming="CharacterEllipsis" />

      <TextBlock x:Name="AppsState" Style="{StaticResource MutedText}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Polite" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="AppsTryAgain" Content="Try again" Click="OnReadAgain" Visibility="Collapsed" />
        <Button x:Name="AppsSearchSystem" Content="Search system apps too" Click="OnSearchSystem" Visibility="Collapsed"
                ToolTip="Show the apps that came with the phone in the Apps tab" />
      </StackPanel>

      <StackPanel x:Name="Sections" Margin="0,0,0,0" />

      <ToggleButton x:Name="AppsShowHiddenToggle" Style="{StaticResource WideToggle}" Margin="0,12,0,0" Visibility="Collapsed"
                    Checked="OnShowHidden" Unchecked="OnShowHidden" AutomationProperties.Name="Show hidden apps">
        <TextBlock x:Name="ShowHiddenText" Text="Show hidden apps" />
      </ToggleButton>
    </StackPanel>
  </StackPanel>
</UserControl>
