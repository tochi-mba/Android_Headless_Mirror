<UserControl x:Class="Rex.Mirror.Views.UpdateOnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Focusable="True"
             AutomationProperties.Name="What is new in this update">
  <Grid Background="#D2050705">
    <Border MaxWidth="720" MaxHeight="680" Margin="28" Padding="24,22"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
            BorderThickness="1" CornerRadius="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="WHAT'S NEW" Style="{StaticResource Eyebrow}" />
          <TextBlock x:Name="UpdateTitle" FontSize="26" FontWeight="SemiBold" Margin="0,7,0,0" />
          <TextBlock x:Name="UpdateIntro" Style="{StaticResource MutedText}" FontSize="13" Margin="0,5,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,16" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="UpdateFeatures" AutomationProperties.Name="New features in this update">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,8,10" Padding="15,13" Background="{StaticResource Raised}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="26" CornerRadius="13" Background="{StaticResource SignalWash}"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding Version}" FontFamily="{StaticResource Mono}" FontSize="10"
                                 Foreground="{StaticResource Signal}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,0,0">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Body}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Where}" FontFamily="{StaticResource Mono}" FontSize="11"
                                 Foreground="{StaticResource Signal}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2">
          <Button x:Name="UpdateFullNotes" Content="Full release notes" Style="{StaticResource GhostButton}"
                  MinHeight="34" Padding="12,5" HorizontalAlignment="Left" Click="OnFullNotes"
                  ToolTip="Open every change in this version on the website" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="UpdateDone" Content="Done" Style="{StaticResource GhostButton}"
                    MinHeight="34" Padding="16,5" Margin="0,0,8,0" Click="OnDone" />
            <Button x:Name="UpdateTour" Content="Show me around" Style="{StaticResource PrimaryButton}"
                    MinHeight="34" Padding="18,5" Click="OnTour"
                    ToolTip="Point at each new feature in the window, one at a time" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
