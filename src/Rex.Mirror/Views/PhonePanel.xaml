<UserControl x:Class="Rex.Mirror.Views.PhonePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rex.Mirror.Views">
  <StackPanel>
    <TextBlock x:Name="Unavailable" Style="{StaticResource MutedText}" Margin="0,10,0,0"
               Text="Connect a phone to change its settings." />

    <StackPanel x:Name="Body">
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SettingsSearch" TextChanged="OnSearch" ToolTip="Filter by name, description or Android key" />
        <Button x:Name="ReloadButton" Grid.Column="1" Content="Reload" Margin="6,0,0,0" Click="OnReload"
                ToolTip="Read every setting from the phone again" />
      </Grid>
      <TextBlock x:Name="SearchHint" Style="{StaticResource MutedText}" FontSize="11" Margin="2,4,0,0"
                 Text="Search phone settings" IsHitTestVisible="False" />

      <TextBlock x:Name="LoadingText" Style="{StaticResource MutedText}" Margin="0,12,0,0" Text="Reading settings from the phone…" />
      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="0,12,0,0" Visibility="Collapsed"
                 Text="No setting matches that search." TextWrapping="Wrap" />

      <StackPanel x:Name="Groups" Margin="0,4,0,0" />

      <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,10,0,0" TextWrapping="Wrap" />

      <Expander x:Name="GroupRaw" Margin="0,18,0,0">
        <Expander.Header>
          <TextBlock Text="All Android keys" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                     Text="Every key in Android's settings provider, including the ones above. Editing here is unguided; keys that would cut off ADB are refused." />
          <views:AdvancedSettingsView x:Name="Advanced" />
        </StackPanel>
      </Expander>
    </StackPanel>
  </StackPanel>
</UserControl>
