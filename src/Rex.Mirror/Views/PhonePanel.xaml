<UserControl x:Class="Rex.Mirror.Views.PhonePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Rex.Mirror.Views">
  <StackPanel>
    <TextBlock x:Name="Unavailable" Style="{StaticResource MutedText}" Margin="0,10,0,0" Text="Connect a phone to change its settings." />
    <StackPanel x:Name="Body">
      <TextBlock Text="DISPLAY" Style="{StaticResource Eyebrow}" />
      <Grid Margin="0,0,0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="44" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Brightness" />
          <Slider x:Name="Brightness" Minimum="1" Maximum="255" Margin="0,2,0,0" PreviewMouseUp="OnBrightnessCommit" KeyUp="OnBrightnessCommit" />
        </StackPanel>
        <TextBlock x:Name="BrightnessValue" Grid.Column="1" Style="{StaticResource MutedText}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,0,4" Text="128" />
      </Grid>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Automatic brightness">
        <CheckBox x:Name="AutoBrightness" Click="OnAutoBrightness" />
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Screen timeout">
        <ComboBox x:Name="Timeout" SelectionChanged="OnTimeout">
          <ComboBoxItem Content="15 seconds" Tag="15000" />
          <ComboBoxItem Content="30 seconds" Tag="30000" />
          <ComboBoxItem Content="1 minute" Tag="60000" />
          <ComboBoxItem Content="2 minutes" Tag="120000" />
          <ComboBoxItem Content="5 minutes" Tag="300000" />
          <ComboBoxItem Content="10 minutes" Tag="600000" />
          <ComboBoxItem Content="30 minutes" Tag="1800000" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Rotation">
        <StackPanel x:Name="RotationButtons" Orientation="Horizontal">
          <RadioButton Content="Auto" Style="{StaticResource Segment}" Tag="auto" Click="OnRotation" />
          <RadioButton Content="0°" Style="{StaticResource Segment}" Tag="0" Click="OnRotation" />
          <RadioButton Content="90°" Style="{StaticResource Segment}" Tag="1" Click="OnRotation" />
          <RadioButton Content="180°" Style="{StaticResource Segment}" Tag="2" Click="OnRotation" />
          <RadioButton Content="270°" Style="{StaticResource Segment}" Tag="3" Click="OnRotation" Margin="0" />
        </StackPanel>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Dark mode">
        <ComboBox x:Name="DarkMode" SelectionChanged="OnDarkMode">
          <ComboBoxItem Content="Automatic" Tag="auto" />
          <ComboBoxItem Content="Light" Tag="no" />
          <ComboBoxItem Content="Dark" Tag="yes" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Text size">
        <ComboBox x:Name="FontScale" SelectionChanged="OnFontScale">
          <ComboBoxItem Content="Small" Tag="0.85" />
          <ComboBoxItem Content="Default" Tag="1.0" />
          <ComboBoxItem Content="Large" Tag="1.15" />
          <ComboBoxItem Content="Extra large" Tag="1.30" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Animations">
        <ComboBox x:Name="Animation" SelectionChanged="OnAnimation">
          <ComboBoxItem Content="Off" Tag="0" />
          <ComboBoxItem Content="Fast" Tag="0.5" />
          <ComboBoxItem Content="Default" Tag="1" />
          <ComboBoxItem Content="Slow" Tag="1.5" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show touches">
        <CheckBox x:Name="ShowTouches" Click="OnShowTouches" />
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Stay awake while charging">
        <CheckBox x:Name="StayAwake" Click="OnStayAwake" />
      </HeaderedContentControl>

      <TextBlock Text="CONNECTIVITY" Style="{StaticResource Eyebrow}" />
      <UniformGrid Columns="3">
        <StackPanel Margin="0,0,3,0">
          <TextBlock Text="Wi-Fi" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <UniformGrid Columns="2">
            <Button Content="On" Margin="0,0,2,0" Tag="wifi:enable" Click="OnConnectivity" />
            <Button Content="Off" Margin="2,0,0,0" Tag="wifi:disable" Click="OnConnectivity" />
          </UniformGrid>
        </StackPanel>
        <StackPanel Margin="3,0">
          <TextBlock Text="Mobile data" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <UniformGrid Columns="2">
            <Button Content="On" Margin="0,0,2,0" Tag="mobile-data:enable" Click="OnConnectivity" />
            <Button Content="Off" Margin="2,0,0,0" Tag="mobile-data:disable" Click="OnConnectivity" />
          </UniformGrid>
        </StackPanel>
        <StackPanel Margin="3,0,0,0">
          <TextBlock Text="Airplane" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <UniformGrid Columns="2">
            <Button Content="On" Margin="0,0,2,0" Tag="airplane-mode:enable" Click="OnConnectivity" />
            <Button Content="Off" Margin="2,0,0,0" Tag="airplane-mode:disable" Click="OnConnectivity" />
          </UniformGrid>
        </StackPanel>
      </UniformGrid>

      <Expander Margin="0,18,0,0" Foreground="{StaticResource Text}" BorderThickness="0">
        <Expander.Header>
          <TextBlock Text="Advanced" FontWeight="SemiBold" />
        </Expander.Header>
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="Display override" Style="{StaticResource MutedText}" />
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WmSize" ToolTip="Resolution, for example 1080x2400" />
            <Button Grid.Column="1" Content="Apply" Margin="6,0,0,0" Tag="wm-size" Click="OnOverrideApply" />
            <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Tag="wm-size:reset" Click="OnOverrideApply" />
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="WmDensity" ToolTip="Density (DPI), 120 to 1000" />
            <Button Grid.Column="1" Content="Apply" Margin="6,0,0,0" Tag="wm-density" Click="OnOverrideApply" />
            <Button Grid.Column="2" Content="Reset" Margin="6,0,0,0" Tag="wm-density:reset" Click="OnOverrideApply" />
          </Grid>
          <views:AdvancedSettingsView x:Name="Advanced" Margin="0,16,0,0" />
        </StackPanel>
      </Expander>
      <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
