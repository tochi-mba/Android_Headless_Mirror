<UserControl x:Class="Rex.Mirror.Views.ControlsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Grid Margin="0,6,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="SessionButton" Content="Stop mirror" Click="OnSessionButton" />
      <Button x:Name="RestartButton" Grid.Column="1" Content="Restart" Margin="6,0,0,0" ToolTip="Relaunch scrcpy (applies changed mirror settings)" Click="OnRestart" />
    </Grid>

    <TextBlock Text="PHONE" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="NavigationTiles">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource ActionTile}" Content="{Binding}" ToolTip="{Binding Detail}" Tag="{Binding Id}" Click="OnTile" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="PHONE ORIENTATION" Style="{StaticResource Eyebrow}" />
    <UniformGrid Columns="3">
      <Button Content="Portrait" Tag="rotation-portrait" Click="OnTile" Margin="0,0,3,0" ToolTip="Lock Android to portrait · Ctrl+Alt+U" />
      <Button Content="Landscape" Tag="rotation-landscape" Click="OnTile" Margin="3,0" Padding="6,7" ToolTip="Lock Android to landscape · Ctrl+Alt+L" />
      <Button Content="Auto" Tag="rotation-auto" Click="OnTile" Margin="3,0,0,0" ToolTip="Restore sensor rotation · Ctrl+Alt+A" />
    </UniformGrid>
    <TextBlock Text="VIEW" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="ViewTiles">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Button Style="{StaticResource ActionTile}" Content="{Binding}" ToolTip="{Binding Detail}" Tag="{Binding Id}" Click="OnTile" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="ZOOM (PC ONLY)" Style="{StaticResource Eyebrow}" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="−" Width="40" Padding="0" Tag="zoom-out" Click="OnTile" />
      <TextBlock x:Name="ZoomLabel" Grid.Column="1" Text="100%" FontFamily="{StaticResource Mono}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Button Grid.Column="2" Content="+" Width="40" Padding="0" Tag="zoom-in" Click="OnTile" />
      <Button x:Name="ZoomReset" Grid.Column="3" Content="Reset" Margin="6,0,0,0" Tag="zoom-reset" Click="OnTile" IsEnabled="False" />
    </Grid>
    <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
               Text="Two fingers on the touchpad act on the phone (pinch, rotate, pan). Hold Alt to zoom or pan the PC view instead; Alt + wheel and Alt + drag work with a mouse." />

    <TextBlock Text="CLIPBOARD" Style="{StaticResource Eyebrow}" />
    <UniformGrid Columns="4">
      <Button Content="Copy" Margin="0,0,3,0" Tag="copy" Click="OnTile" ToolTip="Copy on the phone into the PC clipboard" />
      <Button Content="Cut" Margin="3,0" Tag="cut" Click="OnTile" />
      <Button Content="Paste" Margin="3,0" Tag="paste" Click="OnTile" ToolTip="Paste the PC clipboard on the phone" />
      <Button Content="Type" Margin="3,0,0,0" Tag="paste-text" Click="OnTile" ToolTip="Type the PC clipboard as keystrokes" />
    </UniformGrid>

    <StackPanel x:Name="PatternSection" Visibility="Collapsed">
      <TextBlock Text="PATTERN GUIDE" Style="{StaticResource Eyebrow}" />
      <TextBlock x:Name="PatternStatus" Style="{StaticResource MutedText}" Text="Shows nine dots over a black lock screen." />
      <UniformGrid Columns="2" Margin="0,8,0,0">
        <Button x:Name="PatternToggle" Content="Show guide" Margin="0,0,3,0" Click="OnPatternToggle" ToolTip="Ctrl+Alt+P" />
        <Button x:Name="PatternCalibrate" Content="Calibrate" Margin="3,0,0,0" Click="OnPatternCalibrate" ToolTip="Ctrl+Alt+C, then arrow keys" />
      </UniformGrid>
    </StackPanel>
  </StackPanel>
</UserControl>
