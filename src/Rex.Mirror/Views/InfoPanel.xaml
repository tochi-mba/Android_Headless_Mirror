<UserControl x:Class="Rex.Mirror.Views.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Text="PHONE" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="DeviceRows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" Style="{StaticResource MutedText}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Text="TOOLS" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="ToolRows">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" Style="{StaticResource MutedText}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <UniformGrid Columns="2" Margin="0,10,0,0">
      <Button Content="Screenshots" Margin="0,0,3,0" Click="OnOpenCaptures" ToolTip="Open the folder screenshots are saved to" />
      <Button Content="Log folder" Margin="3,0,0,0" Click="OnOpenLogs" ToolTip="Open the folder holding mirror.log" />
    </UniformGrid>
    <Button Content="Copy diagnostics" Margin="0,6,0,0" Click="OnCopyDiagnostics"
            ToolTip="Copy a report of the app, the tools and the phone, for pasting into an issue" />

    <TextBlock Text="LEARNING" Style="{StaticResource Eyebrow}" />
    <UniformGrid Columns="2">
      <Button x:Name="TourButton" Content="Take the tour" Margin="0,0,3,0" Click="OnTour" ToolTip="Walk through the window again · F1" />
      <Button x:Name="TipsButton" Content="Show tips again" Margin="3,0,0,0" Click="OnResetTips"
              ToolTip="Offer the one-time hints again the next time each one applies" />
    </UniformGrid>

    <!-- Three short lists instead of one long one: the app's own keys, the plain keys browse mode
         takes over, and the pointer gestures. The keys are drawn as keycaps in one shared column,
         so every description starts at the same place whatever the key's length. -->
    <StackPanel Grid.IsSharedSizeScope="True">
      <StackPanel.Resources>
        <DataTemplate x:Key="ShortcutRow">
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="ShortcutKey" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                    Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">
              <TextBlock Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Text}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </StackPanel.Resources>
      <TextBlock Text="SHORTCUTS" Style="{StaticResource Eyebrow}" />
      <ItemsControl x:Name="ShortcutKeys" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
      <TextBlock x:Name="BrowseHeading" Style="{StaticResource Eyebrow}" />
      <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                 Text="While browse mode is on, these keys act on the phone. Letters still type, and Esc goes back to typing." />
      <ItemsControl x:Name="ShortcutBrowse" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
      <TextBlock Text="GESTURES" Style="{StaticResource Eyebrow}" />
      <ItemsControl x:Name="ShortcutGestures" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
    </StackPanel>

    <TextBlock Text="RECENT LOG" Style="{StaticResource Eyebrow}" />
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Ink}" Padding="8">
      <TextBlock x:Name="LogText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
    </Border>
  </StackPanel>
</UserControl>
