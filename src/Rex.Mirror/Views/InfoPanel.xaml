<UserControl x:Class="Rex.Mirror.Views.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Grid.IsSharedSizeScope="True">
    <StackPanel.Resources>
      <!-- Values in the text face; only the ones people copy or compare character by character
           (the serial, the folder, the version) are set in the mono face. -->
      <DataTemplate x:Key="InfoRow">
        <Grid Margin="0,3">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="InfoKey" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Key}" Style="{StaticResource MutedText}" Margin="0,0,10,0" />
          <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding Mono}" Value="True">
            <Setter TargetName="Value" Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter TargetName="Value" Property="FontSize" Value="12" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </StackPanel.Resources>
    <TextBlock Text="PHONE" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="DeviceRows" ItemTemplate="{StaticResource InfoRow}" Focusable="False" />

    <TextBlock Text="TOOLS" Style="{StaticResource Eyebrow}" />
    <ItemsControl x:Name="ToolRows" ItemTemplate="{StaticResource InfoRow}" Focusable="False" />
    <UniformGrid Columns="2" Margin="0,10,0,0">
      <Button Content="Screenshots" Margin="0,0,3,0" Click="OnOpenCaptures" ToolTip="Open the folder screenshots are saved to" />
      <Button Content="Log folder" Margin="3,0,0,0" Click="OnOpenLogs" ToolTip="Open the folder holding mirror.log" />
    </UniformGrid>
    <Button Content="Copy diagnostics" Margin="0,6,0,0" Click="OnCopyDiagnostics"
            ToolTip="Copy a report of the app, the tools and the phone, for pasting into an issue" />

    <!-- The website's pages, from where questions come up. Each opens the default browser. -->
    <TextBlock Text="HELP" Style="{StaticResource Eyebrow}" />
    <UniformGrid Columns="2">
      <Button x:Name="HelpGuide" Content="User guide" Margin="0,0,3,0" Click="OnHelpLink" Tag="guide"
              ToolTip="Step-by-step recipes, on the website" />
      <Button x:Name="HelpSettings" Content="All settings" Margin="3,0,0,0" Click="OnHelpLink" Tag="settings"
              AutomationProperties.Name="Every setting explained" ToolTip="Every setting explained, on the website" />
    </UniformGrid>
    <UniformGrid Columns="2" Margin="0,6,0,0">
      <Button x:Name="HelpShortcuts" Content="Shortcuts" Margin="0,0,3,0" Click="OnHelpLink" Tag="shortcuts"
              AutomationProperties.Name="Keyboard shortcuts" ToolTip="Every key and gesture, on the website" />
      <Button x:Name="HelpWhatsNew" Content="What's new" Margin="3,0,0,0" Click="OnHelpLink" Tag="changelog" />
    </UniformGrid>
    <Button x:Name="HelpReport" Content="Report a problem" Margin="0,6,0,0" Click="OnHelpLink" Tag="report"
            ToolTip="Open a new GitHub issue with this version filled in. Copy diagnostics above and paste it in." />

    <TextBlock Text="LEARNING" Style="{StaticResource Eyebrow}" />
    <UniformGrid Columns="2">
      <Button x:Name="TourButton" Content="Take the tour" Margin="0,0,3,0" Click="OnTour" ToolTip="Walk through the window again · F1" />
      <Button x:Name="TipsButton" Content="Show tips again" Margin="3,0,0,0" Click="OnResetTips"
              ToolTip="Offer the one-time hints again the next time each one applies" />
    </UniformGrid>

    <!-- Three short lists instead of one long one: the app's own keys, the plain keys browse mode
         takes over, and the pointer gestures. The keys are drawn as keycaps in one shared column,
         so every description starts at the same place whatever the key's length. -->
    <StackPanel>
      <StackPanel.Resources>
        <DataTemplate x:Key="ShortcutRow">
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="InfoKey" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource Raised}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5"
                    Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,10,0">
              <TextBlock Text="{Binding Key}" FontFamily="{StaticResource Mono}" FontSize="11.5" Foreground="{StaticResource Text}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </StackPanel.Resources>
      <TextBlock Text="SHORTCUTS" Style="{StaticResource Eyebrow}" />
      <ItemsControl x:Name="ShortcutKeys" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
      <TextBlock x:Name="BrowseHeading" Style="{StaticResource Eyebrow}" />
      <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                 Text="While browse mode is on, these keys act on the phone. Letters still type, and Esc goes back to typing." />
      <ItemsControl x:Name="ShortcutBrowse" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
      <TextBlock Text="GESTURES" Style="{StaticResource Eyebrow}" />
      <ItemsControl x:Name="ShortcutGestures" ItemTemplate="{StaticResource ShortcutRow}" Focusable="False" />
    </StackPanel>

    <TextBlock Text="RECENT LOG" Style="{StaticResource Eyebrow}" />
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Background="{StaticResource Ink}" Padding="8">
      <!-- A read-only box rather than plain text, so a line can be selected and copied into an issue. -->
      <TextBox x:Name="LogText" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontFamily="{StaticResource Mono}" FontSize="11"
               Foreground="{StaticResource Muted}" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="Wrap"
               AutomationProperties.Name="Recent log" />
    </Border>
  </StackPanel>
</UserControl>
