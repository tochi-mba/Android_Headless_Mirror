<UserControl x:Class="Rex.Mirror.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border x:Name="RestartBar" Background="{StaticResource SignalWash}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Mirror settings apply on the next start." VerticalAlignment="Center" FontSize="12" />
        <Button Grid.Column="1" Content="Restart now" Style="{StaticResource PrimaryButton}" MinHeight="28" Padding="10,3" Click="OnRestartNow" />
      </Grid>
    </Border>

    <Grid Margin="0,10,0,0">
      <TextBox x:Name="SettingsFilter" TextChanged="OnFilter" AutomationProperties.Name="Find a setting"
               ToolTip="Show only the groups that mention this" />
      <TextBlock x:Name="FilterHint" Text="Find a setting" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
    <TextBlock x:Name="FilterEmpty" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed"
               Text="Nothing here mentions that. Phone settings live in the Phone tab." />

    <Expander x:Name="GroupDisplay" Header="Display" IsExpanded="True" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Resolution, frame rate, bit rate and codec apply the next time the mirror starts. Everything below them previews as you change it." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Resolution">
      <ComboBox x:Name="MaxSize" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="Native" Tag="0" />
        <ComboBoxItem Content="2560 px" Tag="2560" />
        <ComboBoxItem Content="1920 px" Tag="1920" />
        <ComboBoxItem Content="1600 px" Tag="1600" />
        <ComboBoxItem Content="1280 px" Tag="1280" />
        <ComboBoxItem Content="1024 px" Tag="1024" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Frame rate">
      <ComboBox x:Name="MaxFps" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="Phone default" Tag="0" />
        <ComboBoxItem Content="30 fps" Tag="30" />
        <ComboBoxItem Content="60 fps" Tag="60" />
        <ComboBoxItem Content="90 fps" Tag="90" />
        <ComboBoxItem Content="120 fps" Tag="120" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Bit rate">
      <ComboBox x:Name="BitRate" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="4 Mbps" Tag="4M" />
        <ComboBoxItem Content="8 Mbps" Tag="8M" />
        <ComboBoxItem Content="12 Mbps" Tag="12M" />
        <ComboBoxItem Content="16 Mbps" Tag="16M" />
        <ComboBoxItem Content="24 Mbps" Tag="24M" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Video codec">
      <ComboBox x:Name="VideoCodec" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="H.264 (lowest latency)" Tag="h264" />
        <ComboBoxItem Content="H.265" Tag="h265" />
        <ComboBoxItem Content="AV1" Tag="av1" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Soft background around the phone">
      <CheckBox x:Name="AmbientEnabled" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <StackPanel x:Name="AmbientOptions" Margin="0,4,0,0">
      <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
                 Text="A blurred copy of the phone screen fills the empty space around the mirror. Changes preview instantly." />
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Where it shows">
        <ComboBox x:Name="AmbientPlacement" SelectionChanged="OnLiveChanged">
          <ComboBoxItem Content="All around the phone" Tag="around" />
          <ComboBoxItem Content="Left of the phone" Tag="left" />
          <ComboBoxItem Content="Right of the phone" Tag="right" />
          <ComboBoxItem Content="Above the phone" Tag="top" />
          <ComboBoxItem Content="Below the phone" Tag="bottom" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="How it scales">
        <ComboBox x:Name="AmbientScaling" SelectionChanged="OnLiveChanged">
          <ComboBoxItem Content="Fill the window (crops)" Tag="cover" />
          <ComboBoxItem Content="Show the whole screen" Tag="fit" />
          <ComboBoxItem Content="Stretch to the window" Tag="stretch" />
        </ComboBox>
      </HeaderedContentControl>
      <StackPanel Margin="0,10,0,0">
        <Grid><TextBlock Text="Opacity" /><TextBlock x:Name="AmbientOpacityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOpacity" AutomationProperties.Name="Soft background opacity" Minimum="0.05" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Blur" /><TextBlock x:Name="AmbientBlurValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientBlur" AutomationProperties.Name="Soft background blur" Minimum="0" Maximum="80" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" ToolTip="0 shows the capture sharp" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Size" /><TextBlock x:Name="AmbientSizeValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientSize" AutomationProperties.Name="Soft background size" Minimum="0.5" Maximum="3" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Horizontal position" /><TextBlock x:Name="AmbientOffsetXValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOffsetX" AutomationProperties.Name="Soft background horizontal position" Minimum="-1" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Vertical position" /><TextBlock x:Name="AmbientOffsetYValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOffsetY" AutomationProperties.Name="Soft background vertical position" Minimum="-1" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Fade towards the edges" /><TextBlock x:Name="AmbientEdgeFadeValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientEdgeFade" AutomationProperties.Name="Soft background edge fade" Minimum="0" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Colour wash" /><TextBlock x:Name="AmbientTintValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientTintStrength" AutomationProperties.Name="Soft background colour wash" Minimum="0" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Wash colour" /><TextBlock x:Name="AmbientTintHueValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientTintHue" AutomationProperties.Name="Soft background wash colour" Minimum="0" Maximum="360" Margin="0,2,0,0" ValueChanged="OnAmbientChanged">
          <Slider.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF4D4D" Offset="0" /><GradientStop Color="#FFE04D" Offset="0.17" /><GradientStop Color="#4DFF4D" Offset="0.33" />
              <GradientStop Color="#4DFFFF" Offset="0.5" /><GradientStop Color="#4D4DFF" Offset="0.67" /><GradientStop Color="#FF4DFF" Offset="0.83" /><GradientStop Color="#FF4D4D" Offset="1" />
            </LinearGradientBrush>
          </Slider.Background>
        </Slider>
        <Grid Margin="0,8,0,0"><TextBlock Text="Live frame rate" /><TextBlock x:Name="AmbientFrameRateValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientFrameRate" AutomationProperties.Name="Soft background frame rate" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" ToolTip="How closely the background follows the video. Lower uses less power." />
      </StackPanel>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Mirror it left to right">
        <CheckBox x:Name="AmbientFlip" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
      </HeaderedContentControl>
      <Button Content="Reset soft background" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetAmbient" />
    </StackPanel>
    </StackPanel></Expander>

    <Expander x:Name="GroupAudio" Header="Audio" IsExpanded="True" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Both apply the next time the mirror starts." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Phone audio on this PC">
      <CheckBox x:Name="Audio" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep audio playing on the phone too">
      <CheckBox x:Name="AudioDup" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="What to capture">
      <ComboBox x:Name="AudioSource" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="What audio to capture">
        <ComboBoxItem Content="Everything the phone plays" Tag="auto" />
        <ComboBoxItem Content="The whole output (mutes the phone)" Tag="output" />
        <ComboBoxItem Content="App playback (apps may opt out)" Tag="playback" />
        <ComboBoxItem Content="Microphone" Tag="mic" />
        <ComboBoxItem Content="Microphone, unprocessed" Tag="mic-unprocessed" />
        <ComboBoxItem Content="Microphone, tuned for video" Tag="mic-camcorder" />
        <ComboBoxItem Content="Microphone, tuned for speech" Tag="mic-voice-recognition" />
        <ComboBoxItem Content="Microphone, tuned for calls" Tag="mic-voice-communication" />
        <ComboBoxItem Content="Voice call, both sides" Tag="voice-call" />
        <ComboBoxItem Content="Voice call, your side" Tag="voice-call-uplink" />
        <ComboBoxItem Content="Voice call, the other side" Tag="voice-call-downlink" />
        <ComboBoxItem Content="Karaoke (microphone and playback)" Tag="voice-performance" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Audio quality">
      <ComboBox x:Name="AudioBitRate" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Audio quality">
        <ComboBoxItem Content="64 kbps" Tag="64K" />
        <ComboBoxItem Content="96 kbps" Tag="96K" />
        <ComboBoxItem Content="128 kbps" Tag="128K" />
        <ComboBoxItem Content="192 kbps" Tag="192K" />
        <ComboBoxItem Content="256 kbps" Tag="256K" />
        <ComboBoxItem Content="320 kbps" Tag="320K" />
      </ComboBox>
    </HeaderedContentControl>
    <TextBlock x:Name="AudioDupHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
               Text="Keeping audio playing on the phone needs &#8220;Everything the phone plays&#8221; or &#8220;App playback&#8221;." />
    </StackPanel></Expander>

    <Expander x:Name="GroupSession" Header="Phone screen &amp; session" Margin="0,12,0,0"><StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Phone screen off while mirroring" />
          <TextBlock Text="Saves battery and blocks touches on the handset." Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="TurnScreenOff" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep the phone awake on USB">
      <CheckBox x:Name="StayAwake" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Turn the phone screen off when the mirror closes">
      <CheckBox x:Name="PowerOffOnClose" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Restart the mirror if it crashes">
      <CheckBox x:Name="RestartOnCrash" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Phone screen timeout while mirrored" />
          <TextBlock Text="The phone's own comes back when the mirror ends." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <ComboBox x:Name="ScreenOffTimeout" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Phone screen timeout while mirrored">
        <ComboBoxItem Content="The phone's own" Tag="0" />
        <ComboBoxItem Content="15 seconds" Tag="15" />
        <ComboBoxItem Content="30 seconds" Tag="30" />
        <ComboBoxItem Content="1 minute" Tag="60" />
        <ComboBoxItem Content="2 minutes" Tag="120" />
        <ComboBoxItem Content="5 minutes" Tag="300" />
        <ComboBoxItem Content="10 minutes" Tag="600" />
        <ComboBoxItem Content="30 minutes" Tag="1800" />
        <ComboBoxItem Content="1 hour" Tag="3600" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Keep this PC awake while mirroring" />
          <TextBlock Text="No screen saver or sleep while the phone is on screen." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="KeepPcAwake" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" AutomationProperties.Name="Keep this PC awake while mirroring" />
    </HeaderedContentControl>
    <TextBlock x:Name="StartAppLabel" Text="Open an app when the mirror starts" Margin="0,12,0,4" />
    <TextBox x:Name="StartApp" LostKeyboardFocus="OnStartApp" KeyDown="OnStartAppKey" TextChanged="OnStartAppText" AutomationProperties.LabeledBy="{Binding ElementName=StartAppLabel}"
             ToolTip="Leave empty to open nothing" />
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="Its package name, like com.spotify.music, or ?name to find it by the start of its name. A + in front restarts it. Press Enter to apply." />
    <TextBlock x:Name="StartAppError" Foreground="{StaticResource Live}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />

    </StackPanel></Expander>
    <Expander x:Name="GroupControls" Header="Controls &amp; zoom" Margin="0,12,0,0"><StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Two-finger gestures go to the phone" />
          <TextBlock x:Name="TouchpadHint" Text="Pinch, rotate and pan like on the phone screen." Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="TwoFinger" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <StackPanel Margin="0,10,0,4">
      <Grid>
        <TextBlock Text="Gesture sensitivity" />
        <TextBlock x:Name="SensitivityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Text="1.0×" />
      </Grid>
      <Slider x:Name="Sensitivity" AutomationProperties.Name="Gesture sensitivity" Minimum="0.25" Maximum="3" Margin="0,2,0,0" ValueChanged="OnSensitivity" />
    </StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Compatibility keyboard" />
          <TextBlock Text="Sends raw keys instead of acting as a plugged-in keyboard. Only if typing misbehaves; applies when the mirror restarts." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="CompatibilityKeyboard" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Alt + pinch / Alt + wheel zooms the PC view">
      <CheckBox x:Name="HostZoom" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show the navigator while zoomed">
      <CheckBox x:Name="Navigator" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>

    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Live picture in the navigator" />
          <TextBlock Text="The whole phone screen, small, with the part you are looking at framed." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="NavigatorPicture" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep the navigator on screen at 100% too">
      <CheckBox x:Name="NavigatorAlways" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Navigator corner">
      <ComboBox x:Name="NavigatorCorner" SelectionChanged="OnLiveChanged">
        <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
        <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
        <ComboBoxItem Content="Top right" Tag="top-right" />
        <ComboBoxItem Content="Top left" Tag="top-left" />
      </ComboBox>
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock Text="Navigator size" /><TextBlock x:Name="NavigatorWidthValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="NavigatorWidth" AutomationProperties.Name="Navigator size" Minimum="100" Maximum="360" Margin="0,2,0,0" ValueChanged="OnAppearanceChanged" />
    <Grid Margin="0,8,0,0"><TextBlock Text="Navigator opacity" /><TextBlock x:Name="NavigatorOpacityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="NavigatorOpacity" AutomationProperties.Name="Navigator opacity" Minimum="0.2" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAppearanceChanged" />
    <Grid Margin="0,8,0,0"><TextBlock Text="Navigator frame rate" /><TextBlock x:Name="NavigatorFrameRateValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="NavigatorFrameRate" AutomationProperties.Name="Navigator frame rate" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnAppearanceChanged" ToolTip="How closely the navigator picture follows the video." />
    <Grid Margin="0,8,0,0"><TextBlock Text="Maximum zoom" /><TextBlock x:Name="MaximumZoomValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="MaximumZoom" AutomationProperties.Name="Maximum zoom" Minimum="1.5" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnAppearanceChanged" />
    <Grid Margin="0,8,0,0"><TextBlock Text="Wheel zoom speed" /><TextBlock x:Name="WheelSpeedValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="WheelSpeed" AutomationProperties.Name="Wheel zoom speed" Minimum="0.05" Maximum="0.5" Margin="0,2,0,0" ValueChanged="OnAppearanceChanged" />
    </StackPanel></Expander>
    <Expander x:Name="GroupInput" Header="Mouse &amp; keyboard" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="How the mouse buttons, the keys and the clipboard reach the phone, on every copy too. They apply the next time the mirror starts." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Right click">
      <ComboBox x:Name="RightClick" SelectionChanged="OnInputChanged" AutomationProperties.Name="Right click" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Middle click (wheel)">
      <ComboBox x:Name="MiddleClick" SelectionChanged="OnInputChanged" AutomationProperties.Name="Middle click" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Mouse back button">
      <ComboBox x:Name="BackButton" SelectionChanged="OnInputChanged" AutomationProperties.Name="Mouse back button" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Mouse forward button">
      <ComboBox x:Name="ForwardButton" SelectionChanged="OnInputChanged" AutomationProperties.Name="Mouse forward button" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Shift + click always clicks on the phone" />
          <TextBlock Text="Whatever the button is set to do above." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="ShiftClicks" Checked="OnInputChanged" Unchecked="OnInputChanged" AutomationProperties.Name="Shift + click always clicks on the phone" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Repeat a held key" />
          <TextBlock Text="With the compatibility keyboard. The phone repeats keys itself otherwise." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="KeyRepeat" Checked="OnInputChanged" Unchecked="OnInputChanged" AutomationProperties.Name="Repeat a held key" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Send the pointer's movement without a click" />
          <TextBlock Text="For apps and games that react to hovering." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="MouseHover" Checked="OnInputChanged" Unchecked="OnInputChanged" AutomationProperties.Name="Send the pointer's movement without a click" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Keep the clipboards in step" />
          <TextBlock Text="Copying on the phone copies on the PC too, and pasting sends the PC's clipboard first." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="ClipboardAutosync" Checked="OnInputChanged" Unchecked="OnInputChanged" AutomationProperties.Name="Keep the clipboards in step" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Paste by typing the text out" />
          <TextBlock Text="For phones that ignore a pasted clipboard." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="LegacyPaste" Checked="OnInputChanged" Unchecked="OnInputChanged" AutomationProperties.Name="Paste by typing the text out" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Game controllers" />
          <TextBlock Text="Handed to the phone through the main view only: every copy would add another controller." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <ComboBox x:Name="Gamepad" SelectionChanged="OnInputChanged" AutomationProperties.Name="Game controllers">
        <ComboBoxItem Content="Keep them on this PC" Tag="disabled" />
        <ComboBoxItem Content="Hand them to the phone" Tag="uhid" />
      </ComboBox>
    </HeaderedContentControl>
    </StackPanel></Expander>
    <Expander x:Name="GroupCopies" Header="Copies of the phone" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Extra live views of an upright phone, side by side, added from the Controls tab. Each copy is a session of its own, so each one asks the phone for another video encoder." />
    <Grid Margin="0,8,0,0"><TextBlock x:Name="CopiesMostLabel" Text="Most copies" /><TextBlock x:Name="CopiesMostValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="CopiesMost" AutomationProperties.LabeledBy="{Binding ElementName=CopiesMostLabel}" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnCopiesSlider"
            ToolTip="Only as many as fit the window at full height can be open, whatever this says." />
    <Grid Margin="0,8,0,0"><TextBlock x:Name="CopiesGapLabel" Text="Space between copies" /><TextBlock x:Name="CopiesGapValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="CopiesGap" AutomationProperties.LabeledBy="{Binding ElementName=CopiesGapLabel}" Minimum="0" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnCopiesSlider" />
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Copy resolution" />
          <TextBlock Text="A lower one is lighter on the phone and the PC. Open copies restart with it." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <ComboBox x:Name="CopiesMaxSize" SelectionChanged="OnCopiesOption" AutomationProperties.Name="Copy resolution">
        <ComboBoxItem Content="Same as the mirror" Tag="0" />
        <ComboBoxItem Content="1920 px" Tag="1920" />
        <ComboBoxItem Content="1600 px" Tag="1600" />
        <ComboBoxItem Content="1280 px" Tag="1280" />
        <ComboBoxItem Content="1024 px" Tag="1024" />
        <ComboBoxItem Content="800 px" Tag="800" />
        <ComboBoxItem Content="480 px" Tag="480" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Open the same copies next time">
      <CheckBox x:Name="CopiesRemember" Checked="OnCopiesOption" Unchecked="OnCopiesOption" AutomationProperties.Name="Open the same copies next time" />
    </HeaderedContentControl>
    </StackPanel></Expander>
    <Expander x:Name="GroupHud" Header="Fullscreen HUD" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"
               Text="In fullscreen the controls hide themselves. Move the pointer to where you put them and they come back. Drag them anywhere by the dotted grip on their left." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show the floating controls">
      <CheckBox x:Name="HudEnabled" Checked="OnHudChanged" Unchecked="OnHudChanged" />
    </HeaderedContentControl>
    <StackPanel x:Name="HudOptions">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Where they sit">
        <ComboBox x:Name="HudPosition" SelectionChanged="OnHudPosition">
          <ComboBoxItem Content="Top" Tag="top" />
          <ComboBoxItem Content="Bottom" Tag="bottom" />
          <ComboBoxItem Content="Left" Tag="left" />
          <ComboBoxItem Content="Right" Tag="right" />
          <ComboBoxItem Content="Top left" Tag="top-left" />
          <ComboBoxItem Content="Top right" Tag="top-right" />
          <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
          <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
        </ComboBox>
      </HeaderedContentControl>
      <Grid x:Name="HudDraggedRow" Margin="0,2,0,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center"
                   Text="Dragged to a spot of their own." />
        <Button x:Name="HudPinBack" Content="Pin it back" Style="{StaticResource GhostButton}"
                HorizontalAlignment="Right" Click="OnHudPinBack"
                ToolTip="Put the controls back where the position above says." />
      </Grid>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show the status line under them">
        <CheckBox x:Name="HudMessages" Checked="OnHudChanged" Unchecked="OnHudChanged" />
      </HeaderedContentControl>
      <Grid Margin="0,10,0,0"><TextBlock Text="Size" /><TextBlock x:Name="HudScaleValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudScale" AutomationProperties.Name="Fullscreen controls size" Minimum="0.75" Maximum="1.75" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <Grid Margin="0,8,0,0"><TextBlock Text="Opacity" /><TextBlock x:Name="HudOpacityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudOpacity" AutomationProperties.Name="Fullscreen controls opacity" Minimum="0.3" Maximum="1" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <Grid Margin="0,8,0,0"><TextBlock Text="Hides after" /><TextBlock x:Name="HudDelayValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
      <Slider x:Name="HudDelay" AutomationProperties.Name="Fullscreen controls hide delay" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnHudSlider" />
      <TextBlock Text="Buttons" Margin="0,14,0,0" />
      <TextBlock x:Name="HudButtonCount" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,6"
                 Text="Tap to add or remove. They appear in this order." TextWrapping="Wrap" />
      <Border Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="8,7" Margin="0,0,0,10">
        <StackPanel>
          <TextBlock Text="PREVIEW" Style="{StaticResource Eyebrow}" FontSize="9" Margin="2,0,0,6" />
          <WrapPanel x:Name="HudPreview" />
        </StackPanel>
      </Border>
      <WrapPanel x:Name="HudButtons" />
      <Button Content="Reset the HUD" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetHud" />
    </StackPanel>
    </StackPanel></Expander>

    <Expander x:Name="GroupLockScreen" Header="Lock screen" Margin="0,12,0,0"><StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Nine-dot guide for pattern locks" />
          <TextBlock Text="For phones whose secure lock screen mirrors as black." Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="PatternEnabled" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Show automatically when locked">
      <CheckBox x:Name="PatternAuto" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Use the phone's real pattern position">
      <CheckBox x:Name="PatternDiscover" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <Button Content="Forget lock-screen answers" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OnForgetLocks" ToolTip="Ask again which lock type each phone uses" />

    </StackPanel></Expander>
    <Expander x:Name="GroupCaptures" Header="Screenshots &amp; recording" Margin="0,12,0,0"><StackPanel>
    <TextBlock Text="Save screenshots to" Margin="0,8,0,0" />
    <TextBlock x:Name="ScreenshotLocation" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,8" />
    <StackPanel Orientation="Horizontal">
      <Button Content="Choose folder…" Click="OnChooseScreenshotFolder" Margin="0,0,6,0" />
      <Button Content="Use default" Click="OnDefaultScreenshotFolder" />
    </StackPanel>
    <TextBlock Text="Applies to new screenshots. Existing files stay where they are." Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />

    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Record every session" />
          <TextBlock Text="Starts recording with the next mirror, into the folder above." Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="Record" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Recording format">
      <ComboBox x:Name="RecordFormat" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Recording format">
        <ComboBoxItem Content="MP4 (plays anywhere)" Tag="mp4" />
        <ComboBoxItem Content="MKV (survives a recording cut short)" Tag="mkv" />
      </ComboBox>
    </HeaderedContentControl>
    </StackPanel></Expander>
    <Expander x:Name="GroupStartup" Header="Startup &amp; window" Margin="0,12,0,0"><StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Start with Windows">
      <CheckBox x:Name="StartWithWindows" Checked="OnStartWithWindows" Unchecked="OnStartWithWindows" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep running in the tray when closed">
      <CheckBox x:Name="RunInBackground" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Open the window when a phone connects">
      <CheckBox x:Name="OpenOnConnect" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Confirm risky Android setting writes">
      <CheckBox x:Name="ConfirmWrites" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>

    </StackPanel></Expander>
    <Expander x:Name="GroupAdvanced" Margin="0,18,0,0">
      <Expander.Header>
        <TextBlock Text="Connection &amp; advanced" FontWeight="SemiBold" />
      </Expander.Header>
      <StackPanel Margin="0,8,0,0">
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Wireless ADB fallback" />
              <TextBlock Text="Off means USB only, which is the recovery path." Style="{StaticResource MutedText}" FontSize="11" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="Wireless" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Enable TCP/IP on the phone from a USB session">
          <CheckBox x:Name="WirelessTcpip" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Fix USB by itself when Windows can't read the phone" />
              <TextBlock x:Name="AutoRepairUsbState" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="AutoRepairUsb" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Smoothing buffer" />
              <TextBlock Text="Holds each frame a moment to even out a shaky connection, such as wireless." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <ComboBox x:Name="VideoBuffer" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Smoothing buffer">
            <ComboBoxItem Content="Off (lowest latency)" Tag="0" />
            <ComboBoxItem Content="50 ms" Tag="50" />
            <ComboBoxItem Content="100 ms" Tag="100" />
            <ComboBoxItem Content="200 ms" Tag="200" />
            <ComboBoxItem Content="500 ms" Tag="500" />
          </ComboBox>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Try a lower resolution if the encoder fails" />
              <TextBlock Text="Off stops the mirror instead and says why." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="DownsizeOnError" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" AutomationProperties.Name="Try a lower resolution if the encoder fails" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Renderer">
          <ComboBox x:Name="RenderDriver" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Renderer"
                    ToolTip="How scrcpy draws the picture on this PC. Change it only if the picture flickers or stays black.">
            <ComboBoxItem Content="Automatic" Tag="" />
            <ComboBoxItem Content="Direct3D" Tag="direct3d" />
            <ComboBoxItem Content="OpenGL" Tag="opengl" />
            <ComboBoxItem Content="OpenGL ES 2" Tag="opengles2" />
            <ComboBoxItem Content="Software (slowest, always works)" Tag="software" />
          </ComboBox>
        </HeaderedContentControl>
        <TextBlock Text="Extra scrcpy arguments" Margin="0,12,0,4" />
        <TextBox x:Name="ExtraArgs" LostFocus="OnExtraArgs" KeyDown="OnExtraArgsKey" AutomationProperties.Name="Extra scrcpy arguments"
                 ToolTip="Passed to scrcpy at launch, for options this app does not expose" />
        <TextBlock Text="Press Enter to apply." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
        <TextBlock x:Name="ExtraArgsError" Foreground="{StaticResource Live}" FontSize="11" Margin="0,4,0,0" />
        <UniformGrid Columns="2" Margin="0,12,0,0">
          <Button Content="Open config.json" Margin="0,0,3,0" Click="OnOpenConfig" ToolTip="Open the settings file in your text editor" />
          <Button Content="Undo last config change" Margin="3,0,0,0" Click="OnRestoreConfig" ToolTip="Put back the settings as they were before the last change" />
        </UniformGrid>
        <Button x:Name="ResetEverything" Content="Reset every app setting" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                Margin="0,12,0,0" Click="OnResetEverything" ToolTip="Put every setting in this panel back to how it ships. Phone settings are untouched." />
      </StackPanel>
    </Expander>
    <TextBlock x:Name="Status" Style="{StaticResource MutedText}" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
