<UserControl x:Class="Rex.Mirror.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:settings="clr-namespace:Rex.Mirror.Views.Settings">
  <StackPanel>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SettingsFilter" TextChanged="OnFilter" AutomationProperties.Name="Find a setting"
               ToolTip="Show only the settings that mention this" />
      <TextBlock x:Name="FilterHint" Text="Find a setting" Style="{StaticResource MutedText}" Margin="10,0,0,0"
                 VerticalAlignment="Center" IsHitTestVisible="False" />
      <ToggleButton x:Name="SettingsChangedOnly" Grid.Column="1" Style="{StaticResource Chip}" Content="Changed" Margin="6,0,0,0"
                    Checked="OnChangedOnly" Unchecked="OnChangedOnly" AutomationProperties.Name="Show only what you changed" />
    </Grid>
    <TextBlock x:Name="FilterCount" Style="{StaticResource MutedText}" FontSize="11" Margin="2,4,0,0" Visibility="Collapsed"
               AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="FilterEmpty" Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed"
               Text="Nothing here mentions that. Phone settings live in the Phone tab." />

    <!-- What you changed, with a way back for each; the groups step aside while it shows. -->
    <StackPanel x:Name="ChangedList" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ChangedCount" Style="{StaticResource MutedText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
      <StackPanel x:Name="ChangedRows" />
      <Button x:Name="ChangedPutAllBack" Content="Put them all back" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnPutAllBack" />
    </StackPanel>

    <settings:ProfilesGroup x:Name="ProfilesSettingsGroup" />

    <Expander x:Name="GroupDisplay" Header="Picture" IsExpanded="True" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="Everything up to Show taps on the phone applies the next time the mirror starts. The soft background previews as you change it." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Resolution">
      <ComboBox x:Name="MaxSize" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="Native" Tag="0" />
        <ComboBoxItem Content="2560 px" Tag="2560" />
        <ComboBoxItem Content="1920 px" Tag="1920" />
        <ComboBoxItem Content="1600 px" Tag="1600" />
        <ComboBoxItem Content="1280 px" Tag="1280" />
        <ComboBoxItem Content="1024 px" Tag="1024" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Frame rate">
      <ComboBox x:Name="MaxFps" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="Phone default" Tag="0" />
        <ComboBoxItem Content="30 fps" Tag="30" />
        <ComboBoxItem Content="60 fps" Tag="60" />
        <ComboBoxItem Content="90 fps" Tag="90" />
        <ComboBoxItem Content="120 fps" Tag="120" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Bit rate">
      <ComboBox x:Name="BitRate" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="4 Mbps" Tag="4M" />
        <ComboBoxItem Content="8 Mbps" Tag="8M" />
        <ComboBoxItem Content="12 Mbps" Tag="12M" />
        <ComboBoxItem Content="16 Mbps" Tag="16M" />
        <ComboBoxItem Content="24 Mbps" Tag="24M" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Video codec">
      <ComboBox x:Name="VideoCodec" SelectionChanged="OnMirrorChanged">
        <ComboBoxItem Content="H.264 (lowest latency)" Tag="h264" />
        <ComboBoxItem Content="H.265" Tag="h265" />
        <ComboBoxItem Content="AV1" Tag="av1" />
      </ComboBox>
    </HeaderedContentControl>
    <!-- One row for the search: the encoder, what was read, and the button that reads them. -->
    <StackPanel Tag="row">
      <HeaderedContentControl Style="{StaticResource SettingRow}">
        <HeaderedContentControl.Header><StackPanel>
          <TextBlock Text="Video encoder" />
          <TextBlock Text="The part of the phone that makes the video. Its own choice suits almost every phone." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel></HeaderedContentControl.Header>
        <ComboBox x:Name="VideoEncoder" SelectionChanged="OnPictureChanged" AutomationProperties.Name="Video encoder">
          <ComboBoxItem Content="The phone's choice" Tag="" />
        </ComboBox>
      </HeaderedContentControl>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="VideoEncoderNote" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"
                   AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="VideoEncoderRead" Grid.Column="1" Content="Read the phone's encoders" Click="OnReadEncoders" />
      </Grid>
    </StackPanel>
    <!-- One row for the search: the box, how to write it and why it was refused. -->
    <StackPanel Tag="row">
      <TextBlock Text="Show only part of the screen" Margin="0,10,0,4" />
      <TextBox x:Name="Crop" LostKeyboardFocus="OnCrop" KeyDown="OnCropKey" TextChanged="OnCropText" AutomationProperties.Name="Show only part of the screen"
               ToolTip="Width:height:x:y in the phone's pixels. Empty shows the whole screen." />
      <TextBlock Text="Width:height:x:y in the phone's pixels, such as 1080:1200:0:600. Empty shows all of it. Press Enter to apply." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
      <TextBlock x:Name="CropError" Foreground="{StaticResource Live}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="When the phone turns" />
        <TextBlock Text="Keep the picture one way, however the phone is held." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <ComboBox x:Name="CaptureOrientation" SelectionChanged="OnPictureChanged" AutomationProperties.Name="When the phone turns">
        <ComboBoxItem Content="The picture turns with it" Tag="" />
        <ComboBoxItem Content="It stays as it started" Tag="@" />
        <ComboBoxItem Content="It stays upright" Tag="@0" />
        <ComboBoxItem Content="It stays turned right" Tag="@90" />
        <ComboBoxItem Content="It stays upside down" Tag="@180" />
        <ComboBoxItem Content="It stays turned left" Tag="@270" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Start the view turned" />
        <TextBlock Text="Only on this PC. Ctrl+Alt+Left and Ctrl+Alt+Right still turn it." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <ComboBox x:Name="StartOrientation" SelectionChanged="OnPictureChanged" AutomationProperties.Name="Start the view turned">
        <ComboBoxItem Content="Upright" Tag="0" />
        <ComboBoxItem Content="Turned right" Tag="90" />
        <ComboBoxItem Content="Upside down" Tag="180" />
        <ComboBoxItem Content="Turned left" Tag="270" />
        <ComboBoxItem Content="Mirrored" Tag="flip0" />
        <ComboBoxItem Content="Mirrored and turned right" Tag="flip90" />
        <ComboBoxItem Content="Mirrored and upside down" Tag="flip180" />
        <ComboBoxItem Content="Mirrored and turned left" Tag="flip270" />
      </ComboBox>
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="AngleLabel" Text="Tilt the picture" /><TextBlock x:Name="AngleValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="Angle" AutomationProperties.LabeledBy="{Binding ElementName=AngleLabel}" Minimum="0" Maximum="359" TickFrequency="1" IsSnapToTickEnabled="True"
            SmallChange="1" LargeChange="15" Margin="0,2,0,0" ValueChanged="OnPictureSlider"
            ToolTip="Degrees clockwise, for a phone in a stand that is not quite straight." />
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Smooth the picture when it is shown smaller" TextWrapping="Wrap" />
        <TextBlock Text="Off can make small text look a little sharper." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="SmoothScaling" Checked="OnPictureChanged" Unchecked="OnPictureChanged" AutomationProperties.Name="Smooth the picture when it is shown smaller" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Show taps on the phone" />
        <TextBlock Text="The phone draws a dot where it is touched, for recordings and for showing others. Put back when the mirror ends." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="ShowTouches" Checked="OnPictureChanged" Unchecked="OnPictureChanged" AutomationProperties.Name="Show taps on the phone" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Soft background around the phone" />
          <TextBlock Text="A blurred copy of the phone screen fills the empty space around the mirror. Changes preview instantly." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="AmbientEnabled" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
    </HeaderedContentControl>
    <StackPanel x:Name="AmbientOptions" Margin="0,4,0,0">
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Where it shows">
        <ComboBox x:Name="AmbientPlacement" SelectionChanged="OnLiveChanged">
          <ComboBoxItem Content="All around the phone" Tag="around" />
          <ComboBoxItem Content="Left of the phone" Tag="left" />
          <ComboBoxItem Content="Right of the phone" Tag="right" />
          <ComboBoxItem Content="Above the phone" Tag="top" />
          <ComboBoxItem Content="Below the phone" Tag="bottom" />
        </ComboBox>
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="How it scales">
        <ComboBox x:Name="AmbientScaling" SelectionChanged="OnLiveChanged">
          <ComboBoxItem Content="Fill the window (crops)" Tag="cover" />
          <ComboBoxItem Content="Show the whole screen" Tag="fit" />
          <ComboBoxItem Content="Stretch to the window" Tag="stretch" />
        </ComboBox>
      </HeaderedContentControl>
      <StackPanel Margin="0,10,0,0">
        <Grid><TextBlock Text="Opacity" /><TextBlock x:Name="AmbientOpacityValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOpacity" AutomationProperties.Name="Soft background opacity" Minimum="0.05" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Blur" /><TextBlock x:Name="AmbientBlurValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientBlur" AutomationProperties.Name="Soft background blur" Minimum="0" Maximum="80" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" ToolTip="0 shows the capture sharp" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Size" /><TextBlock x:Name="AmbientSizeValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientSize" AutomationProperties.Name="Soft background size" Minimum="0.5" Maximum="3" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Horizontal position" /><TextBlock x:Name="AmbientOffsetXValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOffsetX" AutomationProperties.Name="Soft background horizontal position" Minimum="-1" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Vertical position" /><TextBlock x:Name="AmbientOffsetYValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientOffsetY" AutomationProperties.Name="Soft background vertical position" Minimum="-1" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Fade towards the edges" /><TextBlock x:Name="AmbientEdgeFadeValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientEdgeFade" AutomationProperties.Name="Soft background edge fade" Minimum="0" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Colour wash" /><TextBlock x:Name="AmbientTintValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientTintStrength" AutomationProperties.Name="Soft background colour wash" Minimum="0" Maximum="1" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" />
        <Grid Margin="0,8,0,0"><TextBlock Text="Wash colour" />
          <Border x:Name="AmbientTintHueSwatch" Width="28" Height="12" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Center"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" AutomationProperties.Name="The wash colour chosen" /></Grid>
        <Slider x:Name="AmbientTintHue" AutomationProperties.Name="Soft background wash colour" Minimum="0" Maximum="360" Margin="0,2,0,0" ValueChanged="OnAmbientChanged"
                Foreground="Transparent">
          <Slider.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF4D4D" Offset="0" /><GradientStop Color="#FFE04D" Offset="0.17" /><GradientStop Color="#4DFF4D" Offset="0.33" />
              <GradientStop Color="#4DFFFF" Offset="0.5" /><GradientStop Color="#4D4DFF" Offset="0.67" /><GradientStop Color="#FF4DFF" Offset="0.83" /><GradientStop Color="#FF4D4D" Offset="1" />
            </LinearGradientBrush>
          </Slider.Background>
        </Slider>
        <Grid Margin="0,8,0,0"><TextBlock Text="Background refresh rate" /><TextBlock x:Name="AmbientFrameRateValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
        <Slider x:Name="AmbientFrameRate" AutomationProperties.Name="Soft background frame rate" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnAmbientChanged" ToolTip="How closely the background follows the video. Lower uses less power." />
      </StackPanel>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Flip horizontally">
        <CheckBox x:Name="AmbientFlip" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
      </HeaderedContentControl>
      <HeaderedContentControl Style="{StaticResource SettingRow}" Header="While zoomed in">
        <ComboBox x:Name="AmbientWhenZoomed" SelectionChanged="OnLiveChanged" AutomationProperties.Name="The soft background while zoomed in">
          <ComboBoxItem Content="Keep it" Tag="show" />
          <ComboBoxItem Content="Hide it" Tag="hide" />
        </ComboBox>
      </HeaderedContentControl>
      <Button Content="Reset soft background" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetAmbient" />
    </StackPanel>
    </StackPanel></Expander>

    <Expander x:Name="GroupAudio" Header="Audio" IsExpanded="True" Margin="0,12,0,0"><StackPanel>
    <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
               Text="These apply the next time the mirror starts." />
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Phone audio on this PC">
      <CheckBox x:Name="Audio" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Keep audio playing on the phone too">
      <CheckBox x:Name="AudioDup" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRowStacked}" Header="What to capture">
      <ComboBox x:Name="AudioSource" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="What audio to capture">
        <ComboBoxItem Content="Everything the phone plays" Tag="auto" />
        <ComboBoxItem Content="The whole output (mutes the phone)" Tag="output" />
        <ComboBoxItem Content="App playback (apps may opt out)" Tag="playback" />
        <ComboBoxItem Content="Microphone" Tag="mic" />
        <ComboBoxItem Content="Microphone, unprocessed" Tag="mic-unprocessed" />
        <ComboBoxItem Content="Microphone, tuned for video" Tag="mic-camcorder" />
        <ComboBoxItem Content="Microphone, tuned for speech" Tag="mic-voice-recognition" />
        <ComboBoxItem Content="Microphone, tuned for calls" Tag="mic-voice-communication" />
        <ComboBoxItem Content="Voice call, both sides" Tag="voice-call" />
        <ComboBoxItem Content="Voice call, your side" Tag="voice-call-uplink" />
        <ComboBoxItem Content="Voice call, the other side" Tag="voice-call-downlink" />
        <ComboBoxItem Content="Karaoke (microphone and playback)" Tag="voice-performance" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Audio quality">
      <ComboBox x:Name="AudioBitRate" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Audio quality">
        <ComboBoxItem Content="64 kbps" Tag="64K" />
        <ComboBoxItem Content="96 kbps" Tag="96K" />
        <ComboBoxItem Content="128 kbps" Tag="128K" />
        <ComboBoxItem Content="192 kbps" Tag="192K" />
        <ComboBoxItem Content="256 kbps" Tag="256K" />
        <ComboBoxItem Content="320 kbps" Tag="320K" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Sound format">
      <ComboBox x:Name="AudioCodec" SelectionChanged="OnRemainingChanged" AutomationProperties.Name="Sound format">
        <ComboBoxItem Content="Opus (smallest)" Tag="opus" />
        <ComboBoxItem Content="AAC" Tag="aac" />
        <ComboBoxItem Content="FLAC (lossless)" Tag="flac" />
        <ComboBoxItem Content="Raw (heaviest on Wi-Fi)" Tag="raw" />
      </ComboBox>
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="AudioBufferLabel" Text="Sound buffer" /><TextBlock x:Name="AudioBufferValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="AudioBuffer" AutomationProperties.LabeledBy="{Binding ElementName=AudioBufferLabel}" Minimum="0" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnRemainingSlider"
            ToolTip="Evens out a shaky connection; 0 is the lowest delay." />
    <Grid Margin="0,8,0,0"><TextBlock x:Name="AudioOutputBufferLabel" Text="Playback buffer" /><TextBlock x:Name="AudioOutputBufferValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="AudioOutputBuffer" AutomationProperties.LabeledBy="{Binding ElementName=AudioOutputBufferLabel}" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnPictureSlider"
            ToolTip="Raise it if the sound crackles or breaks up on this PC." />
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Only mirror with sound" />
        <TextBlock Text="When the phone cannot send its sound, the mirror stops and says why instead of going on silent." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="RequireAudio" Checked="OnPictureChanged" Unchecked="OnPictureChanged" AutomationProperties.Name="Only mirror with sound" />
    </HeaderedContentControl>
    <TextBlock x:Name="AudioDupHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
               Text="Keeping audio playing on the phone needs &#8220;Everything the phone plays&#8221; or &#8220;App playback&#8221;." />
    </StackPanel></Expander>

    <settings:SoundGroup x:Name="SoundSettingsGroup" />

    <Expander x:Name="GroupSession" Header="Phone screen &amp; session" Margin="0,12,0,0"><StackPanel>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Phone screen off while mirroring" />
          <TextBlock Text="Saves battery and blocks touches on the handset." Style="{StaticResource MutedText}" FontSize="11" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="TurnScreenOff" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Keep the phone awake while mirroring" />
          <TextBlock Text="Over USB; a phone on Wi-Fi keeps its own timeout." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <CheckBox x:Name="StayAwake" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Turn the phone screen off when the mirror closes">
      <CheckBox x:Name="PowerOffOnClose" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Restart the mirror if it crashes">
      <CheckBox x:Name="RestartOnCrash" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
    </HeaderedContentControl>
    <Grid Margin="0,8,0,0"><TextBlock x:Name="RestartLimitLabel" Text="Times in a row before it stops trying" /><TextBlock x:Name="RestartLimitValue" Style="{StaticResource MutedText}" HorizontalAlignment="Right" /></Grid>
    <Slider x:Name="RestartLimit" AutomationProperties.LabeledBy="{Binding ElementName=RestartLimitLabel}" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,2,0,0" ValueChanged="OnPictureSlider"
            ToolTip="A mirror that ran for a minute counts as working again." />
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Stop the mirror after" />
        <TextBlock Text="For a time limit on a shared PC, or a recording of a set length." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <ComboBox x:Name="TimeLimit" SelectionChanged="OnPictureChanged" AutomationProperties.Name="Stop the mirror after">
        <ComboBoxItem Content="Never" Tag="0" />
        <ComboBoxItem Content="15 minutes" Tag="15" />
        <ComboBoxItem Content="30 minutes" Tag="30" />
        <ComboBoxItem Content="1 hour" Tag="60" />
        <ComboBoxItem Content="2 hours" Tag="120" />
        <ComboBoxItem Content="4 hours" Tag="240" />
        <ComboBoxItem Content="8 hours" Tag="480" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Keep the phone from sleeping while mirrored" TextWrapping="Wrap" />
        <TextBlock Text="Even on Wi-Fi, while the mirror is open." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="KeepActive" Checked="OnRemainingChanged" Unchecked="OnRemainingChanged" AutomationProperties.Name="Keep the phone from sleeping while mirrored" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Wake the phone when the mirror starts">
      <CheckBox x:Name="WakeBeforeMirror" Checked="OnRemainingChanged" Unchecked="OnRemainingChanged" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header><StackPanel>
        <TextBlock Text="Dismiss a lock screen that has no PIN or pattern" TextWrapping="Wrap" />
        <TextBlock Text="A swipe-only lock screen gets out of the way by itself." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
      </StackPanel></HeaderedContentControl.Header>
      <CheckBox x:Name="DismissKeyguard" Checked="OnRemainingChanged" Unchecked="OnRemainingChanged" AutomationProperties.Name="Dismiss a lock screen that has no PIN or pattern" />
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Phone screen timeout while mirrored" />
          <TextBlock Text="The phone's own comes back when the mirror ends." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
      </HeaderedContentControl.Header>
      <ComboBox x:Name="ScreenOffTimeout" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Phone screen timeout while mirrored">
        <ComboBoxItem Content="The phone's own" Tag="0" />
        <ComboBoxItem Content="15 seconds" Tag="15" />
        <ComboBoxItem Content="30 seconds" Tag="30" />
        <ComboBoxItem Content="1 minute" Tag="60" />
        <ComboBoxItem Content="2 minutes" Tag="120" />
        <ComboBoxItem Content="5 minutes" Tag="300" />
        <ComboBoxItem Content="10 minutes" Tag="600" />
        <ComboBoxItem Content="30 minutes" Tag="1800" />
        <ComboBoxItem Content="1 hour" Tag="3600" />
      </ComboBox>
    </HeaderedContentControl>
    <HeaderedContentControl Style="{StaticResource SettingRow}">
      <HeaderedContentControl.Header>
        <StackPanel>
          <TextBlock Text="Keep this PC awake while mirroring" />
          <TextBlock Text="No screen saver or sleep while the phone is on screen." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
