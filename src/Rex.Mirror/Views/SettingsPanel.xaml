    </StackPanel></Expander>
    <settings:GlobalKeysGroup x:Name="GlobalKeysSettingsGroup" />
    <settings:ConnectionGroup x:Name="ConnectionSettingsGroup" />

    <Expander x:Name="GroupAdvanced" Margin="0,12,0,0">
      <Expander.Header>
        <TextBlock Text="Connection &amp; advanced" FontWeight="SemiBold" />
      </Expander.Header>
      <StackPanel>
        <HeaderedContentControl Style="{StaticResource SettingRow}" Header="Confirm risky Android setting writes">
          <CheckBox x:Name="ConfirmWrites" Checked="OnLiveChanged" Unchecked="OnLiveChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Reconnect over Wi-Fi if USB drops" />
              <TextBlock Text="Off keeps the mirror on USB only." Style="{StaticResource MutedText}" FontSize="11" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="Wireless" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Turn on the phone's Wi-Fi debugging from USB" />
              <TextBlock Text="While the phone is plugged in, open its wireless port and remember its address, so the reconnect has somewhere to go." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="WirelessTcpip" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Fix USB by itself when Windows can't read the phone" />
              <TextBlock x:Name="AutoRepairUsbState" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="AutoRepairUsb" Checked="OnSessionChanged" Unchecked="OnSessionChanged" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Smoothing buffer" />
              <TextBlock Text="Holds each frame a moment to even out a shaky connection, such as wireless. Off is the lowest latency." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <ComboBox x:Name="VideoBuffer" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Smoothing buffer">
            <ComboBoxItem Content="Off" Tag="0" />
            <ComboBoxItem Content="50 ms" Tag="50" />
            <ComboBoxItem Content="100 ms" Tag="100" />
            <ComboBoxItem Content="200 ms" Tag="200" />
            <ComboBoxItem Content="500 ms" Tag="500" />
          </ComboBox>
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Try a lower resolution if the encoder fails" />
              <TextBlock Text="Off stops the mirror instead and says why." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <CheckBox x:Name="DownsizeOnError" Checked="OnMirrorChanged" Unchecked="OnMirrorChanged" AutomationProperties.Name="Try a lower resolution if the encoder fails" />
        </HeaderedContentControl>
        <HeaderedContentControl Style="{StaticResource SettingRow}">
          <HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Text="Renderer" />
              <TextBlock Text="How scrcpy draws the picture here. Change it only if the picture flickers or stays black; software is slowest but always works." Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </HeaderedContentControl.Header>
          <ComboBox x:Name="RenderDriver" SelectionChanged="OnMirrorChanged" AutomationProperties.Name="Renderer">
            <ComboBoxItem Content="Automatic" Tag="" />
            <ComboBoxItem Content="Direct3D" Tag="direct3d" />
            <ComboBoxItem Content="OpenGL" Tag="opengl" />
            <ComboBoxItem Content="OpenGL ES 2" Tag="opengles2" />
            <ComboBoxItem Content="Software" Tag="software" />
          </ComboBox>
        </HeaderedContentControl>
        <!-- One row for the search: the label, the box and its notes together. -->
        <StackPanel Tag="row">
          <TextBlock Text="Extra scrcpy arguments" Margin="0,12,0,4" />
          <TextBox x:Name="ExtraArgs" LostFocus="OnExtraArgs" KeyDown="OnExtraArgsKey" AutomationProperties.Name="Extra scrcpy arguments"
                   ToolTip="Passed to scrcpy at launch, for options this app does not expose" />
          <TextBlock Text="Press Enter to apply." Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" />
          <TextBlock x:Name="ExtraArgsError" Foreground="{StaticResource Live}" FontSize="11" Margin="0,4,0,0" />
        </StackPanel>
        <UniformGrid Columns="2" Margin="0,12,0,0">
          <Button Content="Open config.json" Margin="0,0,3,0" Click="OnOpenConfig" ToolTip="Open the settings file in your text editor" />
          <Button Content="Undo last change" Margin="3,0,0,0" Click="OnRestoreConfig" ToolTip="Put back the settings as they were before the last change" />
        </UniformGrid>
        <Button x:Name="ResetEverything" Content="Reset every app setting" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                Margin="0,12,0,0" Click="OnResetEverything" ToolTip="Put every setting in this panel back to how it ships. Phone settings are untouched." />
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
